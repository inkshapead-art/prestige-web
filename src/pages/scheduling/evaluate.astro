---
import BookingWidget from "../../components/BookingWidget.astro";
import FormContact from "../../components/FormContact.astro";
import VTurbPlayer from "../../components/VTurbPlayer.astro";
import { phoneNumber, phoneNumberLink } from "../../constants/info";
import LayoutScheduling from "../../layouts/LayoutScheduling.astro";
import Instrucctions from "../../sections/Scheduling/Instrucctions.astro";
import Doit from "../../sections/Schedulingv2/Doit.astro";
import Hero from "../../sections/Schedulingv2/Hero.astro";

const contentUS = {
  badge: "Your call is confirmed — check your email",
  title:
    'Before we talk, <br /> <span class="text-secondary font-georgia">you need to see this.</span>',
  subtitle: "Directly impacts your business. 8 minutes.",
};

const contentEs = {
  badge: "Tu llamada está confirmada. Revisa tu email.",
  title:
    'Antes de que hablemos, <br /> <span class="text-secondary font-title-libre">necesitas ver esto. </span>',
  subtitle: "Afecta directamente a tu negocio. 8 minutos.",
};

const content = contentEs;
---

<LayoutScheduling>
  <main class="w-full flex flex-col justify-center items-center relative z-0">
    <script is:inline>
      try {
        window.sessionStorage.setItem(
          "prestige-pending-schedule-transition",
          "1",
        );
      } catch {
        // Keep the evaluation page working if browser storage is unavailable.
      }
    </script>
    <div
      class="w-full flex flex-col justify-center items-center bg-[#000700] bg-gradient-to-b from-[#002D15] to-[#000800]/0"
    >
      <Hero changeButton="3" />
    </div>
    <section
      class="w-full flex justify-center items-center bg-[#000700]"
      id="form"
    >
      <div
        class="relative z-10 container-full flex flex-col justify-center items-center h-full py-10 md:py-0 gap-10 md:gap-0"
      >
        <div class="flex flex-col justify-center items-center gap-6">
          <h2
            class="text-[16px] lg:text-[24px] font-semibold leading-[150%] text-center text-white my-0 md:my-4"
          >
            <span class="text-secondary underline">PASO 2:</span> Agenda tu llamada
            de calidad
          </h2>
          <p class="text-white text-[16px] font-regular">
            Si no encuentras espacio en el calendario haz <a
              href="https://wa.me/17863966071"
              class="text-secondary underline uppercase">click aqui</a
            >
          </p>
        </div>
        <FormContact />
      </div>
    </section>
  </main>
  <footer class="w-full flex flex-col justify-center items-center">
    <div
      class="flex flex-col justify-center items-center w-full bg-[#000700] py-14 md:py-20 px-4 md:px-0 gap-[23px]"
    >
      <p
        class="text-[24px] md:text-[36px] lg:text-[41px] font-bold leading-[140%] md:leading-[138%] text-white font-title-libre text-center"
      >
        Nos vemos en tu llamada.
      </p>
      <p
        class="text-[16px] lg:text-[19px] font-normal leading-[150%] text-center text-white"
      >
        Si necesitas reagendar, usa el enlace de tu correo de confirmación.
      </p>
    </div>
    {
      /* <div
      class="bg-[#E5E5E5] w-full py-3.5 lg:py-4.5 flex justify-center items-center px-5 xl:px-0"
    >
      <div
        class="w-full max-w-screen lg:max-w-7xl flex flex-col lg:flex-row justify-center items-center gap-2 lg:gap-6"
      >
        <p
          class="text-[10px] lg:text-[12px] lg:text-[13px] leading-[170%] lg:leading-[120%] text-[#404040] dark:text-paragraph-dark font-normal text-center"
        >
          Copyright © 2026 by <a href="https://inkshapegroup.com"
            >Inkshape Group</a
          > | Privacy | <a href="/">Prestige Growth Partners </a> | Florida, USA |
          Call Now: <a href={phoneNumberLink}>{phoneNumber}</a>
        </p>
      </div>
    </div>*/
    }
  </footer>
</LayoutScheduling>

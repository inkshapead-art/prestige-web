---
import EstimateForm from "../../estimate/EstimateForm";
import LayoutScheduling from "../../layouts/LayoutScheduling.astro";
---

<LayoutScheduling>
  <section
    class="w-full h-screen overflow-hidden flex justify-center items-center relative"
  >
    <img
      src="/images/scheduling/fondo-sistema.webp"
      alt="Fondo del sistema"
      class="w-full h-full object-cover inset-0 absolute object-center z-1"
      width="1456"
      height="816"
    />
    <div class="w-full h-full bg-[#000700]/90 absolute inset-0 z-2"></div>
    <EstimateForm client:load />
  </section>
</LayoutScheduling>

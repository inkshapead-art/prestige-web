---
import "../styles/global.css";
import SEOHead from "../components/SEOHead.astro";

export interface Props {
  lang?: string;
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  canonicalPath?: string;
  logoAlt?: string;
}

const contentUS = {
  lang: "en",
  title: "Schedule a Consultation | Prestige Growth Partners",
  description:
    "Schedule your consultation with Prestige Growth Partners. Learn how to access $150K to $1M in business funding and optimize your business credit.",
  keywords:
    "schedule business consultation, funding consultation, business credit strategy, prestige growth partners scheduling",
  image: "/images/portada.jpg",
  canonicalPath: "/scheduling",
  logoAlt: "Prestige Growth Partners Logo",
};

const contentEs = {
  lang: "es",
  title: "Agenda una Consulta | Prestige Growth Partners",
  description:
    "Agenda tu consulta con Prestige Growth Partners. Descubre cómo acceder a $150K a $1M en financiación empresarial y optimiza tu crédito comercial.",
  keywords:
    "agendar consulta empresarial, consulta de financiación, estrategia de crédito empresarial, prestige growth partners agenda",
  image: "/images/portada.jpg",
  canonicalPath: "/scheduling",
  logoAlt: "Logotipo de Prestige Growth Partners",
};

const content = contentEs;

const {
  lang = content.lang,
  title = content.title,
  description = content.description,
  keywords = content.keywords,
  image = content.image,
  canonicalPath = content.canonicalPath,
  logoAlt = content.logoAlt,
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="overflow-x-clip">
  <!-- Meta Pixel Code -->
  <script is:inline>
    !(function (f, b, e, v, n, t, s) {
      if (f.fbq) return;
      n = f.fbq = function () {
        n.callMethod
          ? n.callMethod.apply(n, arguments)
          : n.queue.push(arguments);
      };
      if (!f._fbq) f._fbq = n;
      n.push = n;
      n.loaded = !0;
      n.version = "2.0";
      n.queue = [];
      t = b.createElement(e);
      t.async = !0;
      t.src = v;
      s = b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t, s);
    })(
      window,
      document,
      "script",
      "https://connect.facebook.net/en_US/fbevents.js",
    );
    fbq("init", "1746388196479206");
    fbq("track", "PageView");
  </script>
  <noscript>
    <img
      height="1"
      width="1"
      style="display:none"
      src="https://www.facebook.com/tr?id=1746388196479206&ev=PageView&noscript=1"
    />
  </noscript>
  <!-- End Meta Pixel Code -->
  <head>
    <SEOHead
      lang={lang}
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      canonicalPath={canonicalPath}
    />
  </head>

  <body
    class="scheduling-layout font-family-scheduling antialiased overflow-x-clip bg-white flex flex-col justify-center items-center w-full"
  >
    <header
      class="w-full absolute top-0 left-0 flex justify-center items-center py-4 md:py-0 h-auto md:h-[132px] z-10"
    >
      <a href="/" class="cursor-pointer">
        <img
          src="/images/logo.svg"
          alt={logoAlt}
          width="190"
          height="40"
          class="w-[125px] md:w-[170px] h-auto"
          decoding="async"
          loading="eager"
        />
      </a>
    </header>

    <slot />
  </body>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const animationElements = document.querySelectorAll(
        ".animation-up-fast, .animation-fade-down, .animation-fade-left, .animation-fade-right",
      );

      const animationObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("active");
              animationObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.3 },
      );

      animationElements.forEach((element) => {
        animationObserver.observe(element);
      });
    });
  </script>


</html>

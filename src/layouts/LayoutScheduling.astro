---
import "../styles/global.css";
import SEOHead from "../components/SEOHead.astro";

export interface Props {
  lang?: string;
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  canonicalPath?: string;
}

const {
  lang = "en",
  title = "Schedule a Consultation | Prestige Growth Partners",
  description = "Schedule your consultation with Prestige Growth Partners. Learn how to access $150K to $1M in business funding and optimize your business credit.",
  keywords = "schedule business consultation, funding consultation, business credit strategy, prestige growth partners scheduling",
  image = "/images/home/hero.webp",
  canonicalPath = "/scheduling",
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="overflow-x-clip">
  <head>
    <SEOHead
      lang={lang}
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      canonicalPath={canonicalPath}
    />
    
  </head>

  <body
    class="font-family-scheduling antialiased overflow-x-clip bg-white flex flex-col justify-center items-center w-full"
  >
    <header
      class="w-full absolute top-0 left-0 flex justify-center items-center pt-15 md:pt-[54px] pb-6 md:pb-3 z-10"
    >
      <a href="/" class="cursor-pointer">
        <img
          src="/images/logo.svg"
          alt="Prestige Growth Partners Logo"
          width="190"
          height="40"
          class="w-[147px] md:w-[190px] h-auto"
          decoding="async"
          loading="eager"
        />
      </a>
    </header>
    <main class="flex flex-col w-full justify-center items-center relative z-0">
      <slot />
    </main>
  </body>
</html>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const animationElements = document.querySelectorAll(
      ".animation-up-fast, .animation-fade-down, .animation-fade-left, .animation-fade-right",
    );

    const animationObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
            animationObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 },
    );

    animationElements.forEach((element) => {
      animationObserver.observe(element);
    });
  });
</script>

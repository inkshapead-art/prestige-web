        {content.pausa}
      </p>
    </div>
    <div
      class="grid grid-cols-2 md:grid-cols-3 justify-center items-center gap-2 w-full lg:w-[70%] h-auto"
    >
      <style>
        .carousel-track-vertical {
          gap: 8px;
          align-items: center;
        }
        .carousel-slide-vertical {
          flex: 0 0 auto;
        }
        .carousel-vertical {
          overflow-y: hidden;
        }
      </style>

      <!-- Columna 1: Forward (arriba) -->
      <div class="carousel-vertical overflow-hidden w-full">
        <div class="carousel-track-vertical flex flex-col w-full">
          <!-- Group A (original 3 items) -->
          <div
            class="carousel-slide-vertical w-full flex flex-col justify-center items-center gap-2"
          >
            {
              contentInfluencers.slice(0, 3).map((influencer) => (
                <div class="flex flex-col justify-center items-start gap-2 bg-[#111111] rounded-xs border border-white/5 py-8 px-4.5 w-full hover:scale-101 transition-all duration-300">
                  <img
                    src={`/images/scheduling/${influencer.image}.png`}
                    alt={influencer.name}
                    class="w-[34px] h-[34px] rounded-full grayscale-100"
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="flex flex-col justify-center items-start gap-1">
                    <h3 class="text-[12px] text-[#F5F5F5] tracking-[0.12px] font-normal uppercase">
                      {influencer.name}
                    </h3>
                  </div>
                  <div class="flex flex-col justify-center items-start gap-1">
                    <div class="flex justify-start items-center gap-[7px]">
                      <p class="text-[22px] font-normal leading-[100%] text-[#F5F5F5] font-georgia">
                        {influencer.mount}
                      </p>
                      <div class="flex justify-center items-center py-0.5 px-[7px] border border-[#D3AE6AD3] rounded-[2px]">
                        <p class="text-[8px] font-semibold  tracking-[1.12px] leading-[100%] text-[#D3AE6A] uppercase">
                          {content.credito}
                        </p>
                      </div>
                    </div>
                  </div>
                  <img
                    src={`/images/scheduling/${influencer.img}.svg`}
                    alt={`Bar for ${influencer.name}`}
                    class="w-full h-auto"
                    width="189"
                    height="2"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ))
            }
          </div>
          <!-- Group B (duplicate 3 items for infinite loop) -->
          <div
            class="carousel-slide-vertical w-full flex flex-col justify-center items-center gap-2"
          >
            {
              contentInfluencers.slice(0, 3).map((influencer) => (
                <div class="flex flex-col justify-center items-start gap-2 bg-[#111111] rounded-xs border border-white/5 py-8 px-4.5 w-full hover:scale-101 transition-all duration-300">
                  <img
                    src={`/images/scheduling/${influencer.image}.png`}
                    alt={influencer.name}
                    class="w-[34px] h-[34px] rounded-full grayscale-100"
                    width="64"
                    height="64"

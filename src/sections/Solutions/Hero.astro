---
import Button from "../../components/Button.astro";
import { BUTTON_COLOR_CLASSES } from "../../constants/buttonClasses";
import HeroCardsPanel from "../../components/solutions/HeroCardsPanel.astro";
import type { Language } from "../../types/language.type";
type Translations = typeof import("../../i18n/en").default;
type HeroContent = Translations["solutions"]["business-consulting"]["hero"];
interface Props {
  content: HeroContent;
  solution: string;
  lang: Language;
}
const { content, solution, lang } = Astro.props as Props;
---

<section
  class="w-full flex justify-center items-center relative overflow-hidden h-[calc(100vh-var(--header-height))] md:h-[50vh] xl:h-[calc(100vh-var(--header-height))] bg-[#000800] bg-gradient-to-b from-[#002D15] to-[#000800]/0"
>
  <div class="absolute bottom-0 z-0 pointer-events-none w-full h-full">
    <img
      src="/images/hero-solutions.webp"
      alt="Hero Solutions Prestige"
      class="w-full md:w-auto xl:w-full h-full xl:h-auto object-cover object-[78%_50%] md:object-[77%_50%] xl:object-bottom hidden md:block"
      width="2500"
      height="1061"
      decoding="async"
      loading="eager"
    />
    <img
      src="/images/hero-solutions-mobile.webp"
      alt="Hero Solutions Prestige"
      class="w-full h-full object-cover md:hidden"
      width="430"
      height="932"
      decoding="async"
      loading="eager"
    />
  </div>

  <HeroCardsPanel solution={solution} lang={lang} />
  <div class="back-mobile-hero absolute inset-0 z-2 md:hidden block"></div>
  <div
    class="container-full flex justify-start items-end md:items-center z-10 md:translate-y-[-10%] h-full md:h-auto py-10 md:py-0"
  >
    <div
      class="flex flex-col justify-center items-center md:items-start gap-6 md:gap-10"
    >
      <div
        class="flex flex-col justify-center items-center md:items-start gap-6"
      >
        <h1
          set:html={content.title}
          class="title text-white text-center md:text-left fade-right-a"
        />
        <p
          class="paragraph text-white text-center md:text-left w-full md:w-[60%] xl:w-auto fade-right-a"
          set:html={content.description}
        />
      </div>

      <Button
        text={content.button.label}
        textClass={BUTTON_COLOR_CLASSES.text1}
        extraBtnClass={`${BUTTON_COLOR_CLASSES.bg1} fade-right-a`}
        href={content.button.href}
      />
    </div>
  </div>
</section>

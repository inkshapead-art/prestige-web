---
import Button from "../../components/Button.astro";
import { BUTTON_COLOR_CLASSES } from "../../constants/buttonClasses";
import StatisticsCardPanel from "../../components/solutions/statistics/StatisticsCardPanel.astro";
import type { Language } from "../../types/language.type";

type Translations = typeof import("../../i18n/en").default;
type StatisticsContent =
  Translations["solutions"]["business-consulting"]["statistics"];

interface Props {
  content: StatisticsContent;
  solution: string;
  lang: Language;
}

const { content, solution, lang } = Astro.props as Props;
---

<section
  class="bg-white container-full flex flex-col lg:flex-row justify-center lg:justify-start items-center py-10 md:py-16 lg:py-26 gap-8 lg:gap-10 xl:gap-22"
>
  <div class="w-full md:w-auto lg:w-[45%] xl:w-[50%] relative">
    <StatisticsCardPanel solution={solution} lang={lang} />
  </div>
  <div
    class="flex flex-col justify-center items-start gap-6 md:gap-10 w-full lg:w-auto"
  >
    <div
      class="flex flex-col justify-center items-start gap-6 md:gap-5 text-paragraph"
    >
      <h2 class="title" set:html={content.title} />
      <p class="paragraph">{content.description}</p>
      <div class="flex flex-col justify-center items-start gap-2">
        {
          content.items.map((item) => (
            <div class="flex justify-center items-center gap-2">
              <div class="w-2.5 h-2.5 rounded-full border-[2.5px] border-accent" />
              <p class="paragraph">{item}</p>
            </div>
          ))
        }
      </div>
    </div>
    <Button
      text={content.button.label}
      textClass={BUTTON_COLOR_CLASSES.text1}
      extraBtnClass={`${BUTTON_COLOR_CLASSES.bg1}`}
      href={content.button.href}
    />
  </div>
</section>

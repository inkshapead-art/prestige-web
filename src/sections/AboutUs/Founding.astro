---
type Translations = typeof import("../../i18n/en").default;
type FoundingContent = Translations["aboutUs"]["founding"];
interface Props {
  content: FoundingContent;
}
const { content } = Astro.props as Props;
---

<section
  class="container-full flex flex-col md:flex-row jusitfy-center md:justify-between items-center py-10 md:py-20 gap-8 lg:gap-20"
>
  <div
    class="w-full md:w-[55%] h-auto relative rounded-xl overflow-hidden group "
    style="aspect-ratio: 682/420;"
  >
    <img
      src="/images/home/founding.webp"
      alt="Founding"
      width="1000"
      height="558"
      class="object-cover h-full w-full group-hover:scale-[1.05] transition-all duration-300 ease-in-out"
      decoding="async"
      loading="lazy"
    />
  </div>
  <div
    class="flex flex-col justify-center itmes-start gap-6 md:gap-7 text-paragraph w-full md:w-[45%]"
  >
    <h2 set:html={content.title} class="title fade-up-a" />
    <p class="paragraph fade-up-a">{content.description}</p>
    <div class="flex flex-col justify-center items-start gap-3">
      {
        content.items.map((item,index) => (
          <div class="flex justify-center items-center gap-1 fade-up-a" style={`animation-delay: ${index * 0.1}s`}>
            <img
              src="/images/icons/arrow-r.svg"
              alt="Arrow"
              width="24"
              height="24"
              decoding="async"
              loading="lazy"
            />
            <a
              href={item.href}
              class="text-primary text-[16px] font-semibold leading-[100%] hover:text-secondary transition-all duration-300 ease-in-out"
            >
              {item.label}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

---
type Translations = typeof import("../../i18n/en").default;
type FoundingContent = Translations["aboutUs"]["founding"];
interface Props {
  content: FoundingContent;
}
const { content } = Astro.props as Props;
---

<section class="container-full flex justify-between items-center py-20 gap-20">
  <div
    class="w-[55%] h-auto relative rounded-xl overflow-hidden"
    style="aspect-ratio: 682/420;"
  >
    <img
      src="/images/home/founding.webp"
      alt="Founding"
      width="1000"
      height="558"
      class="object-cover h-full w-full"
      decoding="async"
      loading="lazy"
    />
  </div>
  <div
    class="flex flex-col justify-center itmes-start gap-7 text-paragraph w-[45%]"
  >
    <h2 set:html={content.title} class="title" />
    <p class="paragraph">{content.description}</p>
    <div class="flex flex-col justify-center items-start gap-3">
      {
        content.items.map((item) => (
          <div class="flex justify-center items-center gap-1">
            <img
              src="/images/icons/arrow-r.svg"
              alt="Arrow"
              width="24"
              height="24"
              decoding="async"
              loading="lazy"
            />
            <a
              href={item.href}
              class="text-primary text-[16px] font-semibold leading-[100%] hover:text-secondary transition-all duration-300 ease-in-out"
            >
              {item.label}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

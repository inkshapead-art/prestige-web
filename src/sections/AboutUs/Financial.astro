---
type Translations = typeof import("../../i18n/en").default;
type FinancialContent = Translations["aboutUs"]["financial"];
interface Props {
  content: FinancialContent;
}
const { content } = Astro.props as Props;
---

<section class="container-full py-10 flex justify-center items-center">
  <div
    class="w-full bg-primary flex flex-col md:flex-row justify-start items-center rounded-xl overflow-hidden relative md:px-6 xl:px-16 h-auto md:aspect-1312/747"
  >
    <div
      class="flex flex-col justify-center items-start gap-10 pt-10 pb-8 md:py-0 px-4 md:px-0"
    >
      <div class="flex flex-col justify-center items-start gap-6 text-white">
        <h2
          set:html={content.title}
          class="text-[32px] xl:text-[48px] font-normal leading-[120%] fade-right-a"
        />
        <p class="paragraph w-full md:w-[40%] fade-right-a">{content.description}</p>
      </div>
      <a
        class="text-[16px] text-secondary font-semibold leading-[100%] hover:text-white transition-all duration-300 ease-in-out fade-right-a"
        href={content.link.href}
      >
        {content.link.label}
      </a>
    </div>
    <img
      src="/images/home/financial.webp"
      alt="Financial"
      class="relative md:absolute w-full md:w-auto h-auto md:h-full right-0 fade-left-a"
      width="1400"
      height="1400"
      decoding="async"
      loading="lazy"
    />
  </div>
</section>

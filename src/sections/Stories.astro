---
type Translations = typeof import("../i18n/en").default;
type SuccessStoriesContent = Translations["successStories"];
interface Props {
  content: SuccessStoriesContent;
}
const { content } = Astro.props as Props;
---

<section
  class="container-full flex flex-col justify-center items-center gap-8 md:gap-12 py-10 md:py-20"
>
  <div class="flex flex-col justify-center items-center gap-6 text-paragraph">
    <h1 set:html={content.title} class="title text-center fade-up-a" />
    <p class="paragraph w-full md:w-[70%] lg:w-[50%] text-center fade-up-a">
      {content.description}
    </p>
  </div>
  <div
    class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 justify-center items-start"
  >
    {
      content.items.map((item, index) => (
        <div
          class="w-full flex flex-col justify-center items-start gap-4.5 text-paragraph fade-up-a group"
          style={`animation-delay: ${index * 0.1}s`}
        >
          <div class="w-full h-auto relative overflow-hidden flex justify-end items-start p-4 rounded-xl group aspect-square md:aspect-350/480">
            <img
              src={`/images/persons/${item.image}.webp`}
              alt={item.name}
              width="550"
              height="985"
              decoding="async"
              loading="lazy"
              class="absolute h-full w-full object-cover inset-0  z-0 grayscale group-hover:grayscale-0  transition-all duration-300 ease-in-out group-hover:scale-[1.05]"
            />
            <div class="absolute h-full w-full bg-[#00070066] z-5 top-0 left-0" />
            <div class="bg-accent px-2 py-1 flex justify-center items-center gap-1 rounded-full relative z-10">
              <img
                src={`/images/icons/check-white.svg`}
                alt="Check"
                width="24"
                height="24"
                class="inline-block w-4 h-4"
                decoding="async"
                loading="lazy"
              />
              <p class="paragraph-xs text-white">{item.approved}</p>
            </div>
          </div>
          <h3 class="subtitle">{item.name}</h3>
          <p class="paragraph">{item.description}</p>
        </div>
      ))
    }
  </div>
</section>

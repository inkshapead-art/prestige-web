---
const contentEs = {
  title: "Descubre si tu negocio puede ser el siguiente.",
  description:
    "Sin ser experto en financimiento. Nosotros hacemos el proceso contigo.",
  button: "QUIERO VER si MI NEGOCIO CALIFICA",
  description2:
    "Llamada gratuita. Sin compromiso, para clientes que califican.",
};
const content = contentEs;
---

<section
  class="w-full flex justify-center items-center border-y border-white/20"
>
  <div
    class="container-full flex flex-col justif-center items-center gap-8 md:gap-10 py-14 md:py-20"
  >
    <div class="flex flex-col justify-center items-center gap-6">
      <h2
        class="text-[24px] md:text-[36px] lg:text-[41px] font-bold leading-[140%] md:leading-[138%] text-white font-title-libre text-center"
      >
        {content.title}
      </h2>
      <p
        class="text-[16px] md:text-[19px] font-normal leading-[168%] md:leading-[150%] text-white text-center"
      >
        {content.description}
      </p>
    </div>
    <a
      class="bg-secondary flex items-center justify-center md:px-[48px] py-5.5 rounded-[14px] shrink-0 w-full md:w-[611px] shadow-button hover:-translate-y-1 transition-transform duration-300 ease-in-out"
      href="/scheduling/questions"
    >
      <span
        class="font-medium text-[16px] md:text-[25px] text-[#0a0a0a] tracking-[1.44px] uppercase text-center"
      >
        {content.button}
      </span>
    </a>
    <p
      class="text-[16px] md:text-[19px] font-normal leading-[150%] text-white text-center"
    >
      {content.description2}
    </p>
  </div>
</section>

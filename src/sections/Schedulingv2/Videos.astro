    amount: "+$89,000",
  },
];
---

<section
  class="flex justify-center items-center w-full border-y border-white/20"
>
  <div
    class="w-full flex flex-col justify-center items-center py-14 md:py-20 gap-8 md:gap-10"
  >
    <div
      class="flex flex-col justify-center items-center gap-[23px] text-center px-4 lg:px-0"
    >
      <p
        class="text-[16px] lg:text-[19px] font-bold leading-[100%] md:leading-[100%] text-center text-secondary uppercase tracking-[0.96px] md:tracking-[1.14px]"
      >
        {content.tag}
      </p>
      <h2
        class="text-[24px] md:text-[36px] lg:text-[41px] font-bold leading-[140%] md:leading-[138%] text-white font-title-libre"
        set:html={content.title}
      />
    </div>

    <div class="flex flex-col justify-center items-center gap-2 w-full">
      <style>
        .carousel-track {
          gap: 8px;
          align-items: center;
        }
        .carousel {
          overflow: hidden;
          container-type: inline-size;
        }
      </style>

      <!-- Carrusel 1 (Forward) -->
      <div class="carousel overflow-hidden w-full">
        <div class="carousel-track flex w-full">
          <!-- Group A -->
          <div class="carousel-slide flex shrink-0 items-center gap-2">
            {
              Array.from({ length: 4 }, (_, i) => (
                <div class="overflow-hidden shrink-0 w-[calc((100cqw-8px))] md:w-[calc((100cqw-16px)/3)] lg:w-[calc((100cqw-24px)/4)] aspect-[354/480] h-auto relative group cursor-pointer flex justify-start items-end p-6">
                  <div class="w-full h-full absolute z-10 bg-[#000700]/50 md:bg-[#000700A6] group-hover:bg-transparent transition-all duration-300 ease-in-out inset-0" />
                  <img
                    src={`/images/persons/item-${i + 1}.webp`}
                    alt={`Video ${i + 1}`}
                    class="w-full h-full absolute inset-0 object-cover grayscale-100 group-hover:grayscale-50 group-hover:scale-110 transition-transform duration-300 ease-in-out"
                    width="354"
                    height="352"
                  />
                  <div class="flex flex-col justify-center items-start gap-4 relative z-20">
                    <p class="text-[16px] lg:text-[19px] font-bold leading-[100%] md:leading-[100%] text-center text-secondary uppercase tracking-[0.96px] md:tracking-[1.14px]">
                      {imageContent[i]?.name}
                    </p>
                    <p class="text-[32px] text-white font-bold leading-[138%] font-title-libre">
                      {imageContent[i]?.amount}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
          <!-- Group B -->
          <div class="carousel-slide flex shrink-0 items-center gap-2">
            {
              Array.from({ length: 4 }, (_, i) => (
                <div class="overflow-hidden shrink-0 w-[calc((100cqw-8px))] md:w-[calc((100cqw-16px)/3)] lg:w-[calc((100cqw-24px)/4)] aspect-[354/480] h-auto relative group cursor-pointer flex justify-start items-end p-6">
                  <div class="w-full h-full absolute z-10 bg-[#000700]/50 md:bg-[#000700A6] group-hover:bg-transparent transition-all duration-300 ease-in-out inset-0" />
                  <img
                    src={`/images/persons/item-${i + 1}.webp`}
                    alt={`Video ${i + 1}`}
                    class="w-full h-full absolute inset-0 object-cover grayscale-100 group-hover:grayscale-50 group-hover:scale-110 transition-transform duration-300 ease-in-out"
                    width="354"
                    height="352"
                  />
                  <div class="flex flex-col justify-center items-start gap-4 relative z-20">
                    <p class="text-[16px] lg:text-[19px] font-bold leading-[100%] md:leading-[100%] text-center text-secondary uppercase tracking-[0.96px] md:tracking-[1.14px]">
                      {imageContent[i]?.name}
                    </p>
                    <p class="text-[32px] text-white font-bold leading-[138%] font-title-libre">
                      {imageContent[i]?.amount}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Carrusel 2 (Backward) -->
      <div class="carousel overflow-hidden w-full" data-direction="backward">
        <div class="carousel-track flex w-full">
          <!-- Group B -->
          <div class="carousel-slide flex shrink-0 items-center gap-2">
            {
              Array.from({ length: 4 }, (_, i) => (
                <div class="overflow-hidden shrink-0 w-[calc((100cqw-8px))] md:w-[calc((100cqw-16px)/3)] lg:w-[calc((100cqw-24px)/4)] aspect-[354/480] h-auto relative group cursor-pointer flex justify-start items-end p-6">
                  <div class="w-full h-full absolute z-10 bg-[#000700]/50 md:bg-[#000700A6] group-hover:bg-transparent transition-all duration-300 ease-in-out inset-0" />
                  <img
                    src={`/images/persons/item-${i + 5}.webp`}
                    alt={`Video ${i + 5}`}
                    class="w-full h-full absolute inset-0 object-cover grayscale-100 group-hover:grayscale-50 group-hover:scale-110 transition-transform duration-300 ease-in-out"
                    width="354"
                    height="352"
                  />
                  <div class="flex flex-col justify-center items-start gap-4 relative z-20">
                    <p class="text-[16px] lg:text-[19px] font-bold leading-[100%] md:leading-[100%] text-center text-secondary uppercase tracking-[0.96px] md:tracking-[1.14px]">
                      {imageContent[i + 4]?.name}
                    </p>
                    <p class="text-[32px] text-white font-bold leading-[138%] font-title-libre">
                      {imageContent[i + 4]?.amount}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
          <!-- Group A -->
          <div class="carousel-slide flex shrink-0 items-center gap-2">
            {
              Array.from({ length: 4 }, (_, i) => (
                <div class="overflow-hidden shrink-0 w-[calc((100cqw-8px))] md:w-[calc((100cqw-16px)/3)] lg:w-[calc((100cqw-24px)/4)] aspect-[354/480] h-auto relative group cursor-pointer flex justify-start items-end p-6">
                  <div class="w-full h-full absolute z-10 bg-[#000700]/50 md:bg-[#000700A6] group-hover:bg-transparent transition-all duration-300 ease-in-out inset-0" />
                  <img
                    src={`/images/persons/item-${i + 5}.webp`}
                    alt={`Video ${i + 5}`}
                    class="w-full h-full absolute inset-0 object-cover grayscale-100 group-hover:grayscale-50 group-hover:scale-110 transition-transform duration-300 ease-in-out"
                    width="354"
                    height="352"
                  />
                  <div class="flex flex-col justify-center items-start gap-4 relative z-20">
                    <p class="text-[16px] lg:text-[19px] font-bold leading-[100%] md:leading-[100%] text-center text-secondary uppercase tracking-[0.96px] md:tracking-[1.14px]">
                      {imageContent[i + 4]?.name}
                    </p>
                    <p class="text-[32px] text-white font-bold leading-[138%] font-title-libre">
                      {imageContent[i + 4]?.amount}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
    <p
      class="text-[16px] md:text-[19px] font-normal leading-[150%] md:leading-[168%] text-center text-white"
    >
      {content.description}
    </p>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const carousels = document.querySelectorAll(".carousel");

      carousels.forEach((carouselElement) => {
        const carouselContainer = carouselElement as HTMLElement;
        const track = carouselContainer.querySelector(
          ".carousel-track",
        ) as HTMLElement;
        if (!track) return;

        const slides = Array.from(
          track.querySelectorAll<HTMLElement>(".carousel-slide"),
        );

        if (slides.length < 2) return;

        let anim: Animation | null = null;
        const speedPxPerSec = 25;
        const direction =
          carouselContainer.getAttribute("data-direction") || "forward";

        function startAnim() {
          if (anim) anim.cancel();

          const first = slides[0];
          const slideRect = first.getBoundingClientRect();
          const slideWidth = Math.round(slideRect.width);

          if (!slideWidth) return;

          const trackStyle = getComputedStyle(track);
          const gap = parseFloat(trackStyle.gap || "0") || 0;
          const distance = slideWidth + gap;

          const duration = Math.max(3000, (distance / speedPxPerSec) * 1000);

          if (direction === "backward") {
            anim = track.animate(
              [
                { transform: `translateX(-${distance}px)` },
                { transform: "translateX(0px)" },
              ],
              { duration, iterations: Infinity, easing: "linear" },
            );
          } else {
            anim = track.animate(
              [
                { transform: "translateX(0px)" },
                { transform: `translateX(-${distance}px)` },
              ],
              { duration, iterations: Infinity, easing: "linear" },
            );
          }

          if (carouselContainer.dataset.carouselHoverBound !== "1") {
            carouselContainer.addEventListener("mouseenter", () =>
              anim?.pause(),
            );
            carouselContainer.addEventListener("mouseleave", () =>
              anim?.play(),
            );
            carouselContainer.dataset.carouselHoverBound = "1";
          }
        }

        startAnim();

        window.addEventListener("resize", () => {
          if (anim) anim.cancel();

          const newSlides = Array.from(
            track.querySelectorAll<HTMLElement>(".carousel-slide"),
          );

          if (newSlides.length >= 2) {
            startAnim();
          }
        });
      });
    });
  </script>
</section>

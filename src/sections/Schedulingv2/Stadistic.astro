---
interface StatRow {
  label: string;
  value: string;
  highlight?: boolean;
}

interface StatusItem {
  label: string;
  status: string;
  statusColor: string;
}

type StatCard =
  | {
      variant: "progress";
      title: string;
      description: string;
      label: string;
      value: string;
      valueSuffix?: string;
      progress: string;
      rows: StatRow[];
    }
  | {
      variant: "status";
      title: string;
      description: string;
      label: string;
      items: StatusItem[];
      footerLabel: string;
      footerValue: string;
    }
  | {
      variant: "chart";
      title: string;
      description: string;
      label: string;
      value: string;
      chartSrc: string;
      chartAlt: string;
      rows: StatRow[];
    };

interface StadisticContent {
  eyebrow: string;
  title: string;
  hint: string;
  cards: StatCard[];
  tag: string;
}


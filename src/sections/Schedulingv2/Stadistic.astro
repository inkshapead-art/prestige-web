---

<section
  class="w-full flex justify-center items-center overflow-hidden relative"
  style="background-image: url('/images/scheduling/fondo-sistema.webp'); background-attachment: fixed; background-position: center; background-size: cover; background-repeat: no-repeat;"
>
  <div class="w-full h-full bg-[#000700E5] absolute inset-0 z-0 top-0"></div>
  <div
    class="flex flex-col justify-center items-center gap-10 py-14 md:py-20 container-full relative z-10"
  >
    <div class="flex flex-col justify-center items-center gap-6 md:gap-5.25">
      <p
        class="text-[14px] lg:text-[19px] font-bold leading-[100%] md:leading-[100%] text-center text-secondary uppercase tracking-[0.96px] md:tracking-[1.14px]"
      >
        {content.eyebrow}
      </p>
      <h2
        class="text-[24px] md:text-[36px] lg:text-[41px] font-bold leading-[140%] md:leading-[138%] text-white font-title-libre"
        set:html={content.title}
      />
      <p
        class="text-[16px] md:text-[19px] font-normal leading-[168%] text-center text-white"
      >
        {content.hint}
      </p>
    </div>
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-2 justify-center items-stretch w-full md:w-[95%] lg:w-[849px]"
    >
      {
        content.cards.map((card) => (
          <div class="w-full flex flex-col justify-center items-start gap-[27px] p-6 md:p-8 rounded-lg border border-white/7 bg-[#111] h-auto aspect-420/505 hover:-translate-y-1 transition-all duration-300 ease-in-out">
            <h3 class="text-[16px] lg:text-[19px] font-bold leading-[100%] md:leading-[100%] text-center text-secondary uppercase tracking-[0.96px] md:tracking-[1.14px] ">
              {card.title}
            </h3>
            <p class="text-[16px] md:text-[19px] font-normal leading-[150%]  text-start text-white">
              {card.description}
            </p>
            <div class="flex flex-col justify-center items-start px-7 py-5.25 border border-white/7 rounded-[6px] h-auto  w-full">
              <p class="text-[16px] text-white leading-[100%] font-normal">
                {card.label}
              </p>

              {card.variant === "progress" && (
                <>
                  <p class="text-[48px] font-normal leading-[100%] pt-[26px] pb-[26px] text-white font-title-libre">
                    {card.value}{" "}
                    {card.valueSuffix && (
                      <span class="text-secondary font-title text-[18px] font-normal">
                        {card.valueSuffix}
                      </span>
                    )}
                  </p>
                  <div class="w-full h-2.5 bg-white/10 rounded-full overflow-hidden">
                    <div
                      class="h-full bg-[#D3AE6A] rounded-full transition-all duration-300"
                      style={`width: ${card.progress};`}
                    />
                  </div>
                  <div class="flex flex-col justify-start items-center w-full gap-4.5 pt-[26px]">
                    {card.rows.map((row) => (
                      <div class="w-full flex justify-between">
                        <p class="text-[16px] text-white leading-[100%] font-normal">
                          {row.label}
                        </p>
                        <p
                          class={`text-[16px] leading-[100%] font-normal ${row.highlight ? "text-[#29683C]" : "text-white"}`}
                        >
                          {row.value}
                        </p>
                      </div>
                    ))}
                  </div>
                </>
              )}

              {card.variant === "status" && (
                <>
                  <div class="w-full flex flex-col justify-center items-center gap-3 pt-5.25">
                    {card.items.map((item) => (
                      <div class="bg-white/10 w-full p-4 rounded-xl flex justify-between items-center">
                        <p class="text-[12px] text-white leading-[100%] font-normal">
                          {item.label}
                        </p>
                        <p
                          class={`text-[12px] leading-[100%] font-normal ${item.statusColor}`}
                        >
                          {item.status}
                        </p>
                      </div>
                    ))}
                  </div>
                  <div class="flex flex-col justify-center items-center w-full gap-4.5 pt-5.25">
                    <div class="w-full flex justify-between">
                      <p class="text-[13px] text-[#94A39B] leading-[100%] font-normal">
                        {card.footerLabel}
                      </p>
                      <p class="text-[16px] text-white leading-[100%] font-normal">
                        {card.footerValue}
                      </p>
                    </div>
                  </div>
                </>
              )}

              {card.variant === "chart" && (
                <>
                  <p class="text-[48px] font-normal leading-[100%] pb-2.25 text-white font-title-libre pt-2.25">
                    {card.value}
                  </p>
                  <img
                    src={card.chartSrc}
                    alt={card.chartAlt}
                    class="w-full h-auto"
                    decoding="async"
                    loading="lazy"
                    width="330"
                    height="54"
                  />
                  <div class="flex flex-col justify-center items-center w-full gap-4.5 pt-2.25">
                    {card.rows.map((row) => (
                      <div class="w-full flex justify-between">
                        <p class="text-[12px] text-white leading-[100%] font-normal">
                          {row.label}
                        </p>
                        <p
                          class={`text-[16px] leading-[100%] font-normal ${row.highlight ? "text-[#29683C]" : "text-white"}`}
                        >
                          {row.value}
                        </p>
                      </div>
                    ))}
                  </div>
                </>
              )}
            </div>
          </div>
        ))
      }
    </div>
    <p
      class="text-[16px] md:text-[19px] font-normal leading-[150%] md:leading-[168%] text-center text-white hidden md:block"
    >
      {content.tag}
    </p>
  </div>
</section>

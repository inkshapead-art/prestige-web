---
const contentEs = {
  title: "Un equipo trabajando en tu caso.",
  items: [
    "Un coach de financimiento que te guía de principio a fin.",
    "Un asistente virtual dedicado que arma y ordena tu perfil.",
    "Un equipo que aplica por ti, con relaciones bancarias reales",
    "Un plan claro antes de aplicar, no después.",
  ],
};
const content = contentEs;
---

<section
  class="w-full flex flex-col justify-center items-center border-y border-white/20"
>
  <div
    class="container-full flex flex-col justify-center items-center py-20 gap-16"
  >
    <h2
      class="text-[24px] md:text-[36px] lg:text-[41px] font-bold leading-[140%] md:leading-[138%] text-white font-title-libre"
    >
      {content.title}
    </h2>
    <div
      class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 justify-center justify-between items-center gap-10 md:gap-6 lg:gap-0"
    >
      {
        content.items.map((item, index) => (
          <div class="flex flex-row md:flex-col justify-center items-center gap-4 md:gap-8  max-w-none md:max-w-[300px]">
            <img
              src={`/images/scheduling/work-${index + 1}.svg`}
              class="w-14 h-14 object-contain"
              width="56"
              height="56"
              decoding="async"
              loading="lazy"
            />
            <p class="text-[16px] md:text-[19px] font-normal leading-[150%]  text-white text-center">
              {item}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

---
import VTurbPlayer from "../../components/VTurbPlayer.astro";
const contentUS = {
  description: "The proven funding system <br/> business owners use to unlock",
  title: "$150K and $1M in <br/> business financing",
  description2: "(in just 60 days)",
  buttonLabel: "Schedule My Meeting",
  excelent: "5 · Excellent",
  see: "See testimonials",
};

const contentEs = {
  description: "NECESITAS CAPITAL Y NO SABE POR DONDE EMPEZAR",
  title:
    "Cómo dueños de negocio consiguen <span class='text-secondary'>+100K a 0% de interés en menos de 60 días,</span> sin ser expertos en financiamiento",
  description2:
    "En Prestige Funding System: analizamos tu perfil, preparamos tu  negocio y gestionamos tus <br class='hidden md:block'/> solicitudes de financiamiento.¡Dale play y descubre cómo funciona!",
  buttonLabel: "QUIERO VER si MI NEGOCIO CALIFICA",
  paragraph1: "Llamada gratuita. Sin compromiso, para clientes que califican.",
  paragraph2:
    "Los resultados varian según el perfil de cada negocio. Prestige Growth Partners no es prestamiento",
};
const contentEs2 = {
  description: "SOLO PARA DUEÑOS DE NEGOCIOS EN USA",
  title:
    "Logra <span class='text-secondary'>+$100K a 0% de interés inicial en menos de 60 días,</span> con un plan personalizado y garantizado.",
  description2:
    "Con el mismo metodo que me ayudo a generar mas de 5 millones para mi y mis clientes.",
  buttonLabel: "QUIERO VER si MI NEGOCIO CALIFICA",
  paragraph1:
    "<span class='text-secondary underline'>PASO 1:</span> Mira el video",
  paragraph2:
    "*SOLAMENTE agenda si eres una empresa registrada en Estados Unidos.",
};
const { changeButton = "1" } = Astro.props;
const differentFunnel = changeButton === "3" ? true : false;
const content = differentFunnel ? contentEs2 : contentEs;
const changeButtonValue = String(changeButton);
const buttonHref =
  changeButtonValue === "2"
    ? "#calendar"
    : changeButtonValue === "3" || changeButtonValue === "4"
      ? "#form"
      : "/scheduling/questions";
---

<section
  class="w-full h-auto flex flex-col justify-end items-center pt-[64px] md:pt-[132px]"
>
  <div
    class="flex flex-col justify-center items-center px-4 md:px-0 py-3 md:py-20 w-full gap-6 md:gap-9"
  >
    <div class="flex flex-col justify-center items-center gap-[29px] w-full">
      <p
        class="text-[16px] md:text-[20px] lg:text-[19px] font-bold leading-[150%] md:leading-[100%] text-center text-secondary tracking-[0.96px] md:tracking-normal"
        set:html={content.description}
      />
      <h1
        class="text-[26px] md:text-[36px] lg:text-[44px] font-bold leading-[140%] md:leading-[138%] text-white max-w-[1118px] text-center font-title-libre tracking-[0.8px]"
        set:html={content.title}
      />
    </div>
    <div class="flex flex-col justify-center items-center gap-6 md:gap-[19px]">
      <p
        class="text-[16px] lg:text-[19px] font-normal leading-[150%] text-center text-white"
        set:html={content.description2}
      />
      {
        differentFunnel && (
          <p
            class="text-[16px] lg:text-[24px] font-semibold leading-[150%] text-center text-white my-0 md:my-4"
            set:html={content.paragraph1}
          />
        )
      }
      <div
        class="relative w-full h-auto md:w-[530px] lg:w-[631px] max-w-full overflow-hidden rounded-3xl aspect-video"
      >
        <VTurbPlayer
          playerId="6a8e1aa1655329ca2a97851c"
          class="h-full w-full"
        />
      </div>
      {
        !differentFunnel && (
          <a
            class="bg-secondary flex items-center justify-center md:px-[48px] py-5 rounded-[14px] shrink-0 w-full md:w-[611px] shadow-button hover:-translate-y-1 transition-transform duration-300 ease-in-out"
            href={buttonHref}
          >
            <span class="font-medium text-[16px] md:text-[25px] text-[#0a0a0a] tracking-[1.44px] uppercase text-center">
              {content.buttonLabel}
            </span>
          </a>
        )
      }
    </div>
    {
      differentFunnel ? (
        <div class="flex flex-col justify-center items-center gap-[19px]  border border-secondary py-4 w-full md:w-[530px] lg:w-[631px]">
          <p class="text-[16px] md:text-[24px] font-semibold leading-[150%] md:leading-[168%] text-center text-secondary">
            {content.paragraph2}
          </p>
        </div>
      ) : (
        <div class="flex flex-col justify-center items-center gap-[19px] text-white">
          <p class="text-[16px] md:text-[19px] font-normal leading-[150%] md:leading-[168%] text-center">
            {content.paragraph1}
          </p>
        </div>
      )
    }
  </div>
</section>

---
const contentEs = {
  title: "Preguntas frecuentes",
  items: [
    {
      question: "¿Qué es Prestige Growth Partners?",
      answer:
        "Somos una consultora de financiamiento para emprendedores y empresarios en Estados Unidos. Revisamos tu caso, preparamos tu negocio y aplicamos por ti con el Prestige Funding System.",
    },
    {
      question: "¿Cómo sé que esto es real y no una estafa?",
      answer:
        "Puedes ver casos reales con nombre y monto en esta página, conocer a Ronmel Charry en el video y hablar con nosotros en una llamada gratuita. Estamos en Doral, Florida, y puedes llamarnos al 786-338-6177. No necesitas pagar nada para hablar con nosotros.",
    },
    {
      question: "¿Quién es Ronmel Charry?",
      answer:
        "Es el fundador de Prestige. Hace unos años se quedó con deudas y el crédito destruido, aprendió a la fuerza cómo funcionan realmente los bancos y hoy ese conocimiento es el Prestige Funding System. Existe para que tu negocio deje de quedarse pequeño por no conocer las reglas.",
    },
    {
      question: "¿Atienden en español?",
      answer: "Sí. Atendemos en español y en inglés.",
    },
    {
      question: "¿Necesito saber de financiamiento o haber pedido uno antes?",
      answer:
        "No. Para eso estamos. Puedes empezar aunque nunca hayas pedido financiamiento: en el diagnóstico revisamos tu punto de partida y te decimos qué tienes a favor y qué hay que preparar antes de aplicar. Tú no llenas formularios ni pierdes semanas aprendiendo: nuestro equipo hace el proceso contigo.",
    },
    {
      question: "¿Cómo funciona el Prestige Funding System?",
      answer:
        "Tiene cuatro fases. 1. Diagnóstico: analizamos tu perfil y el de tu negocio y te decimos qué te frena. 2. Perfil bankable: reparamos y optimizamos lo que haga falta. 3. Aplicación estratégica: aplicamos en secuencia, con relaciones bancarias reales. 4. Escalamiento: tu coach te acompaña a acceder a más capital con el tiempo.",
    },
    {
      question: "¿Quién trabaja en mi caso?",
      answer:
        "Un coach de financiamiento que te guía de principio a fin, un asistente virtual dedicado que arma y ordena tu perfil, y un equipo que aplica por ti.",
    },
    {
      question: "¿Cómo es la llamada y tiene costo?",
      answer:
        "Es una llamada gratuita y sin compromiso, de 45 minutos, para entender tu negocio y decirte qué te frena y qué capital podría estar a tu alcance. Si hay encaje, te explicamos cómo trabajaríamos juntos. Si no, te lo decimos con honestidad. Ten a la mano tus ingresos mensuales aproximados y tu credit score estimado para que la llamada sea específica a tu caso.",
    },
  ],
};
const content = contentEs;
---

<section class="w-full flex justify-center items-center">
  <div
    class="container-full flex flex-col justify-center items-center gap-10 py-20"
  >
    <h2
      class="text-[24px] md:text-[36px] lg:text-[41px] font-bold leading-[140%] md:leading-[138%] text-white font-title-libre"
    >
      {content.title}
    </h2>
    <div class="w-full flex flex-col justify-center items-center gap-2" data-faq-list>
      {
        content.items.map((item, index) => (
          <div
            class="faq-item w-full flex flex-col justify-center items-start bg-[#111] rounded-lg py-4 px-6"
            data-faq-item
            data-open={index === 0 ? "true" : "false"}
          >
            <button
              type="button"
              class="faq-header w-full flex justify-between items-center gap-4 cursor-pointer text-left"
              data-faq-header
              aria-expanded={index === 0 ? "true" : "false"}
            >
              <p class="text-[16px] md:text-[19px] font-normal leading-[150%] text-secondary text-start">
                {index + 1}. {item.question}
              </p>
              <span class="shrink-0 w-6 h-6 flex items-center justify-center">
                <svg
                  class="faq-icon-plus w-6 h-6"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M12 1.5C6.20156 1.5 1.5 6.20156 1.5 12C1.5 17.7984 6.20156 22.5 12 22.5C17.7984 22.5 22.5 17.7984 22.5 12C22.5 6.20156 17.7984 1.5 12 1.5ZM12 20.7188C7.18594 20.7188 3.28125 16.8141 3.28125 12C3.28125 7.18594 7.18594 3.28125 12 3.28125C16.8141 3.28125 20.7188 7.18594 20.7188 12C20.7188 16.8141 16.8141 20.7188 12 20.7188Z"
                    fill="#D3AE6A"
                  />
                  <path
                    d="M16.3125 11.25H12.75V7.6875C12.75 7.58437 12.6656 7.5 12.5625 7.5H11.4375C11.3344 7.5 11.25 7.58437 11.25 7.6875V11.25H7.6875C7.58437 11.25 7.5 11.3344 7.5 11.4375V12.5625C7.5 12.6656 7.58437 12.75 7.6875 12.75H11.25V16.3125C11.25 16.4156 11.3344 16.5 11.4375 16.5H12.5625C12.6656 16.5 12.75 16.4156 12.75 16.3125V12.75H16.3125C16.4156 12.75 16.5 12.6656 16.5 12.5625V11.4375C16.5 11.3344 16.4156 11.25 16.3125 11.25Z"
                    fill="#D3AE6A"
                  />
                </svg>
                <svg
                  class="faq-icon-minus w-6 h-6"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M12 1.5C6.20156 1.5 1.5 6.20156 1.5 12C1.5 17.7984 6.20156 22.5 12 22.5C17.7984 22.5 22.5 17.7984 22.5 12C22.5 6.20156 17.7984 1.5 12 1.5ZM12 20.7188C7.18594 20.7188 3.28125 16.8141 3.28125 12C3.28125 7.18594 7.18594 3.28125 12 3.28125C16.8141 3.28125 20.7188 7.18594 20.7188 12C20.7188 16.8141 16.8141 20.7188 12 20.7188Z"
                    fill="#D3AE6A"
                  />
                  <path
                    d="M16.3125 11.25H7.6875C7.58437 11.25 7.5 11.3344 7.5 11.4375V12.5625C7.5 12.6656 7.58437 12.75 7.6875 12.75H16.3125C16.4156 12.75 16.5 12.6656 16.5 12.5625V11.4375C16.5 11.3344 16.4156 11.25 16.3125 11.25Z"
                    fill="#D3AE6A"
                  />
                </svg>
              </span>
            </button>
            <div class="faq-panel w-full" data-faq-panel>
              <div class="faq-panel-inner overflow-hidden">
                <p class="text-[16px] md:text-[19px] font-normal leading-[150%] text-white text-start mt-6">
                  {item.answer}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  .faq-item[data-open="true"] .faq-panel {
    grid-template-rows: 1fr;
  }
  .faq-panel-inner {
    overflow: hidden;
    min-height: 0;
  }
  .faq-item[data-open="true"] .faq-icon-plus {
    display: none;
  }
  .faq-item[data-open="false"] .faq-icon-minus {
    display: none;
  }
</style>

<script>
  const items = document.querySelectorAll("[data-faq-item]");

  function setItem(item: HTMLElement, open: boolean) {
    const el = item;
    el.dataset.open = open ? "true" : "false";
    const header = el.querySelector("[data-faq-header]");
    if (header) header.setAttribute("aria-expanded", open ? "true" : "false");
  }

  items.forEach((item) => {
    const header = item.querySelector("[data-faq-header]");
    header?.addEventListener("click", () => {
      const isOpen = (item as HTMLElement).dataset.open === "true";
      // Siempre debe quedar uno abierto: si ya está abierto, no hacer nada
      if (isOpen) return;
      items.forEach((other) => setItem(other as HTMLElement, other === item));
    });
  });
</script>

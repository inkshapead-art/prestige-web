---
import Button from "../components/Button.astro";
import { BUTTON_COLOR_CLASSES } from "../constants/buttonClasses";
type Translations = typeof import("../i18n/en").default;
type ProcessContent = Translations["howItWorks"]["process"];
interface Props {
  content: ProcessContent;
}
const { content } = Astro.props as Props;
---

<section
  class="flex container-full justify-center items-center gap-12 pt-10 pb-5 md:py-20 flex-col text-paragraph"
>
  <div class="flex flex-col justify-center items-center gap-6 md:gap-10">
    <div class="flex flex-col justify-center items-center gap-6 md:gap-4">
      <h2 set:html={content.title} class="title text-center fade-up-a" />
      <p class="paragraph text-center fade-up-a" set:html={content.description} />
    </div>
    <Button
      text={content.button.label}
      textClass={BUTTON_COLOR_CLASSES.text1}
      extraBtnClass={`${BUTTON_COLOR_CLASSES.bg1} fade-up-a`}
      href={content.button.href}
    />
  </div>
  <div
    class="grid grid-cols-1 md:grid-cols-5 md:grid-rows-2 gap-6 w-full h-full min-h-[400px] max-w-[1090px]"
  >
    <!-- Fila 1 -->
    <div
      class="col-span-1 md:col-span-2 bg-[#F6F6F6] text-paragraph p-6 md:p-4 lg:p-8 rounded-xl flex flex-col justify-center items-start gap-4 md:gap-6 fade-up-a"
    >
      <p
        class="text-[10px] font-normal leading-[150%] tracking-[1px] rounded-full px-2 py-1 bg-primary-dark text-white uppercase"
      >
        {content.items[0].step}
      </p>
      <h3 class="subtitle">{content.items[0].title}</h3>
      <p class="paragraph">{content.items[0].description}</p>
      <div
        class="w-full md:flex justify-center items-center bg-white rounded-lg p-4 gap-6 hidden "
      >
        <div
          class="relative w-full h-auto flex justify-center items-center max-w-[58px]"
        >
          <img
            src={`/images/icons/loader-2.svg`}
            alt="Loader"
            width="63"
            height="63"
            class="inline-block w-[58px] h-[58px]"
            decoding="async"
            loading="lazy"
          />
          <div
            class="absolute inset-0 flex flex-col items-center justify-center text-center z-4"
          >
            <span
              class="text-[12.5px] font-semibold leading-[100%] text-paragraph"
            >
              82%
            </span>
          </div>
        </div>
        <img
          src={`/images/icons/process-1.svg`}
          alt="Process"
          width="225"
          height="56"
          decoding="async"
          loading="lazy"
          class="w-[70%] lg:flex-1 lg:h-auto"
        />
      </div>
    </div>
    <div
      class="col-span-1 md:col-span-3 bg-[#F6F6F6] text-paragraph p-6 md:p-4 lg:p-8 rounded-xl flex justify-center items-start gap-4 md:gap-6 fade-up-a "
      style="animation-delay: 0.1s"
    >
      <div class="flex flex-col justify-center items-start gap-6">
        <p
          class="text-[10px] font-normal leading-[150%] tracking-[1px] rounded-full px-2 py-1 bg-primary-dark text-white uppercase"
        >
          {content.items[1].step}
        </p>
        <h3 class="subtitle">{content.items[1].title}</h3>
        <p class="paragraph">{content.items[1].description}</p>
      </div>
      <div
        class="w-auto h-[75%] lg:h-full bg-white p-7 md:flex justify-center items-center rounded-lg hidden self-center lg:self-start"
        style="aspect-ratio: 305/293;"
      >
        <img
          src={`/images/icons/process-2.svg`}
          alt="Process"
          width="305"
          height="293"
          decoding="async"
          loading="lazy"
          class="w-full h-full object-contain"
        />
      </div>
    </div>

    <!-- Fila 2 -->
    <div
      class="col-span-1 md:col-span-3 bg-[#F6F6F6] text-paragraph p-6 md:p-4 lg:p-8 rounded-xl flex justify-center items-start gap-4 md:gap-6 fade-up-a"
    >
      <div class="flex flex-col justify-center items-start gap-6">
        <p
          class="text-[10px] font-normal leading-[150%] tracking-[1px] rounded-full px-2 py-1 bg-primary-dark text-white uppercase"
        >
          {content.items[2].step}
        </p>
        <h3 class="subtitle">{content.items[2].title}</h3>
        <p class="paragraph">{content.items[2].description}</p>
      </div>
      <div
        class="w-auto h-[80%] lg:h-full bg-white p-7 md:flex justify-center items-center rounded-lg hidden self-center lg:self-start"
        style="aspect-ratio: 305/293;"
      >
        <img
          src={`/images/icons/process-3.svg`}
          alt="Process"
          width="305"
          height="293"
          decoding="async"
          loading="lazy"
          class="w-full h-full object-contain"
        />
      </div>
    </div>
    <div
      class="col-span-1 md:col-span-2 bg-[#F6F6F6] text-paragraph p-6 md:p-4 lg:p-8 rounded-xl flex flex-col justify-center items-start gap-4 md:gap-6 fade-up-a"
      style="animation-delay: 0.1s"
    >
      <p
        class="text-[10px] font-normal leading-[150%] tracking-[1px] rounded-full px-2 py-1 bg-primary-dark text-white uppercase"
      >
        {content.items[3].step}
      </p>
      <h3 class="subtitle">{content.items[3].title}</h3>
      <p class="paragraph">{content.items[3].description}</p>
      <div
        class="w-full md:flex justify-center items-center bg-white rounded-lg p-4 gap-6 hidden "
      >
        <img
          src={`/images/icons/process-4.svg`}
          alt="Process 4"
          width="316"
          height="14"
          class="w-full h-auto"
          decoding="async"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

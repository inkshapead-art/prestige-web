---
type Translations = typeof import("../../i18n/en").default;
type NeedContent = Translations["main"]["need"];
import Button from "../../components/Button.astro";
import { BUTTON_COLOR_CLASSES } from "../../constants/buttonClasses";
interface Props {
  content: NeedContent;
}
const { content } = Astro.props as Props;
---

<section
  class="container-full flex flex-col justify-center items-start gap-8 md:gap-12 relative z-0 py-10 md:py-20"
>
  <div class="flex flex-col justify-center items-center gap-6 text-paragraph">
    <h2 set:html={content.title} class="title text-center fade-up-a" />
    <p class="paragraph w-full md:w-[80%] lg:w-[63%] text-center fade-up-a">{content.description}</p>
  </div>
  <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-6 justify-center items-stretch">
  {
    content.list.map((item, index) => (
      <div class="flex flex-col justify-between items-start gap-6 md:gap-10 bg-[#F6F6F6] rounded-xl p-6 md:p-4 lg:p-8 fade-up-a" style={`animation-delay: ${index * 0.2}s`}>
        <!-- Contenedor principal del texto con flex-1 para expandirse -->
        <div class="flex flex-col flex-1 justify-start items-start gap-4 text-paragraph">
          <img
            src={`/images/icons/${item.icon}.svg`}
            alt={item.title}
            width="48"
            height="48"
            decoding="async"
            loading="lazy"
          />
          <h3 class="subtitle">{item.title}</h3>
          <p class="paragraph hidden md:block">{item.description}</p>
          <div class="flex flex-col justify-center items-start gap-4">
            {item.items.map((i, index) => (
              <div class="flex justify-center items-center gap-2">
                <img
                  src={`/images/icons/check-green.svg`}
                  alt={i}
                  width="32"
                  height="32"
                  class="w-8 h-8"
                  decoding="async"
                  loading="lazy"
                />
                <p set:html={i} class="paragraph" />
              </div>
            ))}
          </div>
        </div>

        <!-- Botón con mt-auto para fijarse abajo -->
        <a
          href={item.button.href}
          class="w-full mt-auto flex justify-center items-center cursor-pointer hover:-translate-y-[2px] transition-all duration-300 ease-in-out z-[10] hover:scale-[1.02] box-border py-3 px-6 rounded-[4px] font-medium leading-[150%] md:leading-[100%] text-[15px] uppercase bg-accent text-white text-center"
        >
          {item.button.label}
        </a>
      </div>
    ))
  }
</div>
</section>
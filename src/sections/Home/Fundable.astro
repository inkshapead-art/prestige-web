---
type Translations = typeof import("../../i18n/en").default;
type FundableContent = Translations["main"]["fundable"];
import Button from "../../components/Button.astro";
import { BUTTON_COLOR_CLASSES } from "../../constants/buttonClasses";
interface Props {
  content: FundableContent;
}
const { content } = Astro.props as Props;
---

<section
  class="w-full flex flex-col justify-center items-center relative z-0 pt-10 md:pt-20 pb-5 md:pb-10 container-full"
>
  <div
    class="bg-[#001C07] grid grid-cols-1 md:grid-cols-2 justify-center items-center overflow-hidden rounded-xl"
  >
    <div
      class="w-full flex flex-col justify-center items-start gap-6 md:gap-3 xl:gap-8 p-6 md:px-6 lg:px-12 md:py-0"
    >
      <h2 set:html={content.title} class="title-sm text-white fade-right-a" />
      <div
        class="flex flex-col justify-center items-start gap-4 md:gap-2 lg:gap-4 text-white fade-right-a"
      >
        {
          content.items.map((item) => (
            <div class="flex justify-center items-center gap-2">
              <div class="w-2.5 h-2.5 rounded-full border-[2.5px] border-secondary" />
              <p class="paragraph">{item}</p>
            </div>
          ))
        }
      </div>
      <Button
        text={content.button.label}
        textClass={BUTTON_COLOR_CLASSES.text1}
        extraBtnClass={`${BUTTON_COLOR_CLASSES.bg1} fade-right-a`}
        href={content.button.href}
      />
    </div>
    <div class="w-full h-auto relative overflow-hidden fade-left-a" aspect-ratio="1/1">
      <img
        src={`/images/home/fundable.webp`}
        alt={content.title}
        width="800"
        height="600"
        decoding="async"
        loading="lazy"
        class="h-full w-full object-cover"
      />
    </div>
  </div>
</section>

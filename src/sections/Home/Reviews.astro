---
import ReviewCarousel from "../../components/ReviewCarousel.tsx";
type Translations = typeof import("../../i18n/en").default;
type ReviewsContent = Translations["main"]["reviews"];
interface Props {
  content: ReviewsContent;
}
const { content } = Astro.props as Props;
---

<section
  class="back-gradient flex flex-col justify-center items-center py-10 md:py-20 gap-8 md:gap-11 w-full" id="reviews"
>
  <h2 set:html={content.title} class="title text-white text-center fade-up-a" />
  <ReviewCarousel items={content.items} client:load />
</section>

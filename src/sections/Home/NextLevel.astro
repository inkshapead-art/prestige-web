---
type Translations = typeof import("../../i18n/en").default;
type NextLevelContent = Translations["main"]["nextLevel"];
interface Props {
  content: NextLevelContent;
}
const { content } = Astro.props as Props;
import Button from "../../components/Button.astro";
import { BUTTON_COLOR_CLASSES } from "../../constants/buttonClasses";
---

<section
  class="w-full flex flex-col justify-center items-center relative z-0 py-10"
>
  <div
    class="container-full flex justify-center items-center overflow-hidden rounded-xl relative h-auto"
    style="aspect-ratio: 1312/747"
  >
    <img
      src={`/images/home/next-level.webp`}
      alt={content.title}
      width="1584"
      height="672"
      decoding="async"
      loading="lazy"
      class="h-full w-full object-cover absolute inset-0 object-center z-0"
    />
    <div
      class="w-full p-16 flex justify-between items-center relative z-5 h-full"
    >
      <div class="flex flex-col justify-center items-start gap-6">
        <h2 set:html={content.title} class="title text-white" />
        <p class="paragraph text-white w-[70%]">{content.description}</p>
        <Button
          text={content.button.label}
          textClass={BUTTON_COLOR_CLASSES.text1}
          extraBtnClass={`${BUTTON_COLOR_CLASSES.bg1} mt-4`}
          href={content.button.href}
        />
      </div>
      <img
        src="/images/logo.svg"
        alt="Logo Prestige"
        class="w-[191px] h-10 self-end"
        width="191"
        height="40"
        decoding="async"
        loading="lazy"
      />
    </div>
  </div>
</section>

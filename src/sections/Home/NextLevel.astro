---
type Translations = typeof import("../../i18n/en").default;
type NextLevelContent = Translations["main"]["nextLevel"];
interface Props {
  content: NextLevelContent;
}
const { content } = Astro.props as Props;
import Button from "../../components/Button.astro";
import { BUTTON_COLOR_CLASSES } from "../../constants/buttonClasses";
---

<section
  class="w-full flex flex-col justify-center items-center relative z-0 py-5 md:py-10 container-full"
>
  <div
    class="w-full flex justify-center items-center overflow-hidden rounded-xl relative h-auto aspect-343/754 md:aspect-1312/747 group"
  >
    <img
      src={`/images/home/next-level.webp`}
      alt={content.title}
      width="1584"
      height="672"
      decoding="async"
      loading="lazy"
      class="h-full w-full object-cover absolute object-[55%_20%] md:object-center z-0 group-hover:scale-[1.1] transition-all duration-300 ease-in-out"
    />
    <div
      class="w-full p-6 md:p-10 xl:p-16 flex justify-start md:justify-between itmes-start md:items-center relative z-5 h-full"
    >
      <div
        class="flex flex-col justify-start md:justify-center items-start gap-6"
      >
        <h2 set:html={content.title} class="title text-white fade-up-a" />
        <p class="paragraph text-white w-[70%] fade-up-a">
          {content.description}
        </p>
        <Button
          text={content.button.label}
          textClass={BUTTON_COLOR_CLASSES.text1}
          extraBtnClass={`${BUTTON_COLOR_CLASSES.bg1} mt-4 fade-up-a`}
          href={content.button.href}
        />
      </div>
      <img
        src="/images/logo.svg"
        alt="Logo Prestige"
        class="w-[191px] h-10 self-end hidden md:block"
        width="191"
        height="40"
        decoding="async"
        loading="lazy"
      />
    </div>
  </div>
</section>

---
import Button from "../../components/Button.astro";
import { BUTTON_COLOR_CLASSES } from "../../constants/buttonClasses";
type Translations = typeof import("../../i18n/en").default;
type HeroContent = Translations["main"]["hero"];
interface Props {
  content: HeroContent;
}
const { content } = Astro.props as Props;

// Comprueba si la URL coincide con la raíz o los prefijos de idioma (/ , /es, /es/, /en, /en/)
const pathname = Astro.url.pathname;
const isHomePage = /^\/(en|es)?\/?$/.test(pathname);
---

<section
  class="w-full flex justify-center items-center relative overflow-hidden h-[calc(100vh-var(--header-height))] md:h-[60vh] xl:h-[calc(100vh-var(--header-height))] back-gradient"
>
  <img
    src="/images/home/hero.webp"
    alt="Hero Pretige"
    class="w-auto h-[90%] lg:h-[80%] xl:h-[97%] absolute bottom-0 right-0 xl:right-[7%] xl:object-center z-0 hidden md:block"
    width="1200"
    height="1372"
    decoding="async"
    loading="eager"
  />
  <img
    src="/images/home/hero-mobile.webp"
    alt="Hero Pretige"
    class="w-[100%] h-auto absolute inset-0 object-center z-0 md:hidden"
    width="700"
    height="1269`"
    decoding="async"
    loading="eager"
  />
  <div class="back-mobile-hero absolute inset-0 z-2 md:hidden block"></div>
  <div
    class="container-full flex justify-start items-center z-10 py-6 md:py-0 h-full"
  >
    <div
      class="flex flex-col justify-end md:justify-center items-center md:items-start gap-4 md:gap-10 h-full md:h-auto w-full md:w-auto"
    >
      <div
        class="flex flex-col justify-center items-center md:items-start gap-6"
      >
        <h1
          set:html={content.title}
          class="title text-white text-center md:text-left w-auto md:w-[50%] xl:w-auto fade-right-a"
        />
        <p
          class={`paragraph text-white w-full md:w-[36%] text-center md:text-left fade-right-a ${isHomePage ? "hidden md:block" : "block"}`}
        >
          {content.description}
        </p>
      </div>
      {
        content.list.length > 0 && (
          <div class="flex flex-col md:flex-row justify-center md:justify-start items-start md:items-center gap-2 md:gap-2 fade-right-a">
            {content.list.map((item, index) => (
              <>
                <div class="flex justify-center items-center gap-2">
                  <img
                    src={`/images/icons/${item.icon}.svg`}
                    alt={item.icon}
                    width="32"
                    height="32"
                    class="w-8 h-8"
                    decoding="async"
                    loading="lazy"
                  />
                  <p
                    set:html={item.label}
                    class="paragraph text-white capitalize"
                  />
                </div>
                <div class="self-stretch w-[1px] bg-white/10 last:hidden hidden md:block" />
              </>
            ))}
          </div>
        )
      }
      <Button
        text={content.button.label}
        textClass={BUTTON_COLOR_CLASSES.text1}
        extraBtnClass={`${BUTTON_COLOR_CLASSES.bg1} fade-right-a`}
        href={content.button.href}
      />
    </div>
  </div>
</section>

---
import { ChevronDown, ChevronRight, Menu, X, Plus } from "@lucide/astro";
import {
  emailAddress,
  facebookLink,
  instagramLink,
  phoneNumber,
  phoneNumberLink,
  tikTokLink,
  youtubeLink,
} from "../constants/info";
import Button from "./Button.astro";
import ChangeLanguage from "./ChangeLanguage.astro";

type Translations = typeof import("../i18n/en").default;
type HeaderContent = Translations["header"];
interface Props {
  content?: HeaderContent;
}
const { content } = Astro.props as Props;

// Obtener la ruta actual y normalizar el path sin prefijo de idioma
const currentPath = Astro.url.pathname;
// Normalizar: remover idioma y trailing slash
const normalized =
  currentPath.replace(/^\/(en|es)/, "").replace(/\/$/, "") || "/";
// Detectar el idioma actual ('en' o 'es')
const match = currentPath.match(/^\/(en|es)/);
const lang = match ? match[1] : "en";
const isSuccessStoriesPage = normalized === "/success-stories";
const socialMedia = [
  {
    icon: "facebook",
    href: facebookLink,
  },
  {
    icon: "instagram",
    href: instagramLink,
  },
  {
    icon: "tiktok",
    href: tikTokLink,
  },
  {
    icon: "youtube",
    href: youtubeLink,
  },
];
---

<header
  class={`fixed left-0 right-0 z-50 w-full flex flex-col justify-center items-center top-0 ${isSuccessStoriesPage ? "bg-white" : "bg-primary"}`}
  id="site-header"
  style="transition: background-color 0.3s ease-out;"
>
  <div class="container-full flex justify-between items-center relative py-4">
    <a
      href={`/${lang}`}
      aria-label="Ir a la página principal"
      title="Pressure Growth Partners- Init"
    >
      {
        isSuccessStoriesPage ? (
          <img
            src="/images/logo-color.svg"
            alt="Logo de Prestige - Growth Partners"
            width="180"
            height="36"
            class="cursor-pointer w-40 md:w-[191px] h-auto"
          />
        ) : (
          <img
            src="/images/logo.svg"
            alt="Logo de Prestige - Growth Partners"
            width="180"
            height="36"
            class="cursor-pointer w-40 md:w-[191px] h-auto"
          />
        )
      }
    </a>
    <div
      class="relative flex flex-row justify-center items-center h-auto w-auto z-10 transform translate-x-0 transition-transform duration-300 ease-out"
    >
      <nav>
        <ul
          class="hidden relative lg:flex items-center flex-row justify-center w-auto gap-8"
        >
          {
            content?.nav.map((item, index) => {
              const itemPathWithoutHash = item.href.split("#")[0];
              const isActive =
                normalized === itemPathWithoutHash ||
                (index === 1 && normalized.startsWith("/solutions"));
              const isSolution = index === 1;
              return (
                <li
                  class={`flex flex-row items-center justify-center group w-auto text-center ${isSolution ? "relative dropdown-parent" : ""}`}
                  id={`nav-item-${index}`}
                >
                  <a
                    href={`/${lang}${item.href}`}
                    class="relative transition-colors duration-300 flex justify-center items-center"
                  >
                    <p
                      class={`text-[15px] font-normal leading-[150%] transition-all duration-300 ease-in-out ${isSuccessStoriesPage ? "text-paragraph" : "text-white"}`}
                      set:html={item.label}
                    />
                    {isSolution && (
                      <ChevronDown
                        class={`w-4 h-4 ${isSuccessStoriesPage ? "text-paragraph" : "text-white"}`}
                      />
                    )}
                    {!isSolution && (
                      <span
                        class={`absolute -bottom-2 left-1/2 h-0.5 ${isSuccessStoriesPage ? "bg-paragraph" : "bg-white"} transition-all duration-300 ease-out -translate-x-1/2 ${isActive ? "w-8" : "w-0 group-hover:w-8 group-hover:bg-secondary"}`}
                      />
                    )}
                  </a>
                  {isSolution && (
                    <div
                      class="dropdown-menu absolute top-13 left-0 mt-0 w-[273px] flex-col items-center bg-white z-40 hidden opacity-0 pointer-events-none transition-all duration-200 ease-out -translate-x-[25%] overflow-hidden p-4 rounded-lg shadow-[0_90px_25px_0_rgba(0,0,0,0),0_57px_23px_0_rgba(0,0,0,0.01),0_32px_19px_0_rgba(0,0,0,0.03),0_14px_14px_0_rgba(0,0,0,0.04),0_4px_8px_0_rgba(0,0,0,0.05)]"
                      data-dropdown-menu
                    >
                      {content.solutions.map((sub) => (
                        <a
                          href={`/${lang}${sub.href}`}
                          class="w-full text-[16px] text-paragraph font-normal leading-[150%] transition-all duration-300 ease-in-out hover:font-semibold flex justify-between items-center gap-2 p-2 rounded-sm hover:bg-black/5"
                        >
                          <span>{sub.label}</span>
                        </a>
                      ))}
                    </div>
                  )}
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>
    <div class="flex justify-center items-center gap-2 md:gap-6">
      <Button
        text={content?.buttons[0].label}
        href={content?.buttons[0].href}
        textClass="text-paragraph uppercase"
        extraBtnClass="hidden xl:block bg-secondary"
      />
      <ChangeLanguage isProjectPage={isSuccessStoriesPage} />
      <button
        type="button"
        aria-label="Abrir menú de navegación"
        title="Abrir menú"
        class="flex lg:hidden items-center justify-center cursor-pointer w-8 h-8"
        id="hamburger-btn"
      >
        <Menu class="w-full h-full text-secondary" />
        <span class="sr-only">Abrir menú de navegación</span>
      </button>
    </div>
  </div>
</header>

<div
  class="fixed top-0 right-0 bottom-0 lg:hidden flex items-start bg-white text-paragraph flex-col justify-between h-full z-60 pb-12 px-4 pt-6 gap-12 transform translate-x-full transition-transform duration-300 ease-out w-full"
  id="mobile-menu"
>
  <div class="flex flex-col justify-center items-start gap-6 w-full">
    <X
      class="block cursor-pointer z-20 w-6 h-6 text-paragraph self-end"
      id="close-btn"
      aria-label="Cerrar menú de navegación"
      title="Cerrar menú"
      role="button"
      tabindex="0"
    />
    <nav class="w-full">
      <ul
        class="relative flex items-start flex-col justify-center w-full gap-4"
      >
        {
          content?.nav.map((item, index) => {
            const itemPathWithoutHash = item.href.split("#")[0];
            const isActive =
              normalized === itemPathWithoutHash ||
              (index === 1 && normalized.startsWith("/solutions"));
            const isSolution = index === 1;
            return (
              <>
                <li
                  class={`flex flex-col items-start justify-start group gap-3.5 px-0 w-full text-start ${isSolution ? "relative" : ""} ${isActive && !isSolution ? "bg-accent text-white uppercase px-4" : ""}`}
                  id={`mobile-nav-item-${index}`}
                >
                  <a
                    href={
                      isSolution ? "javascript:void(0)" : `/${lang}${item.href}`
                    }
                    class="relative transition-colors duration-300 flex justify-between items-center w-full py-5 gap-2"
                    data-solution-toggle={isSolution ? "true" : "false"}
                    aria-expanded="false"
                    aria-controls={
                      isSolution ? "mobile-solutions-submenu" : undefined
                    }
                  >
                    <p
                      class={`text-[14px] leading-[25.5px] font-normal tracking-[-0.5px] ${isActive && !isSolution ? "text-white" : "text-paragraph"}`}
                      set:html={item.label}
                    />
                    {isSolution && (
                      <Plus
                        class="w-5 h-5 text-primary transition-transform duration-300"
                        data-chevron="true"
                      />
                    )}
                  </a>
                  {isSolution && (
                    <div
                      id="mobile-solutions-submenu"
                      class="flex-col justify-center items-center w-full bg-primary divide-y divide-secondary hidden absolute z-20 top-full left-0 translate-y-1"
                      data-solution-menu="true"
                    >
                      {content.solutions.map((sub) => (
                        <a
                          href={`/${lang}${sub.href}`}
                          class="paragraph text-white py-4 transition-colors duration-300 ease-in-out cursor-pointer px-6 w-full text-center font-semibold"
                        >
                          {sub.label}
                        </a>
                      ))}
                    </div>
                  )}
                </li>
                <div class="w-full h-[1px] bg-[#E7E7E7]" />
              </>
            );
          })
        }
      </ul>
    </nav>
  </div>

  <Button
    text={content?.buttons[0].label}
    href={content?.buttons[0].href}
    target="_blank"
    extraBtnClass={`bg-secondary w-full`}
  />
  <div class="flex justify-center items-center gap-4 w-full">
    {
      socialMedia.map((item) => (
        <a href={item.href}>
          <img
            src={`/images/icons/${item.icon}.svg`}
            width="24"
            height="24"
            class="w-8 h-8"
            decoding="async"
            loading="lazy"
            alt={item.icon}
          />
        </a>
      ))
    }
  </div>
  <style>
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    @media (max-width: 1023px) {
      .dropdown-menu {
        display: none !important;
      }
    }
  </style>
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // 0. DESKTOP DROPDOWN WITH HOVER INTENT (prevents flicker on mouse leave)
    function initDesktopDropdown() {
      if (window.innerWidth < 1024) return;

      const dropdownParents = document.querySelectorAll(".dropdown-parent");

      dropdownParents.forEach((parent) => {
        const menu = parent.querySelector("[data-dropdown-menu]");
        if (!menu) return;

        let hideTimeout;
        let isHoveringMenu = false;
        let isHoveringParent = false;

        // Create invisible bridge element - covers gap between parent (top-0 to ~top-9) and menu (top-13 = 52px)
        const bridge = document.createElement("div");
        bridge.className = "dropdown-bridge";
        bridge.style.cssText = `
          position: absolute;
          top: 100%;
          left: -12px;
          right: -12px;
          height: 20px;
          background: transparent;
          z-index: 39;
          pointer-events: auto;
        `;
        parent.style.position = "relative";
        parent.appendChild(bridge);

        const showMenu = () => {
          clearTimeout(hideTimeout);
          menu.classList.remove("hidden", "opacity-0", "pointer-events-none");
          menu.classList.add("flex", "opacity-100", "pointer-events-auto");
        };

        const hideMenu = () => {
          hideTimeout = setTimeout(() => {
            if (!isHoveringParent && !isHoveringMenu) {
              menu.classList.add("hidden", "opacity-0", "pointer-events-none");
              menu.classList.remove(
                "flex",
                "opacity-100",
                "pointer-events-auto",
              );
            }
          }, 150);
        };

        // Use mouseover/mouseout with relatedTarget check to handle child elements
        parent.addEventListener("mouseover", (e) => {
          // Check if we're entering from outside the parent (not from child elements)
          if (!parent.contains(e.relatedTarget)) {
            isHoveringParent = true;
            showMenu();
          }
        });

        parent.addEventListener("mouseout", (e) => {
          // Check if we're leaving to outside the parent (not to child elements)
          if (!parent.contains(e.relatedTarget)) {
            isHoveringParent = false;
            hideMenu();
          }
        });

        menu.addEventListener("mouseover", (e) => {
          if (!menu.contains(e.relatedTarget)) {
            isHoveringMenu = true;
            clearTimeout(hideTimeout);
          }
        });

        menu.addEventListener("mouseout", (e) => {
          if (!menu.contains(e.relatedTarget)) {
            isHoveringMenu = false;
            hideMenu();
          }
        });

        bridge.addEventListener("mouseover", (e) => {
          if (!bridge.contains(e.relatedTarget)) {
            isHoveringParent = true;
            clearTimeout(hideTimeout);
          }
        });

        bridge.addEventListener("mouseout", (e) => {
          if (!bridge.contains(e.relatedTarget)) {
            isHoveringParent = false;
            hideMenu();
          }
        });
      });
    }

    // Run on load and on resize
    initDesktopDropdown();
    let resizeTimeout;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(initDesktopDropdown, 100);
    });

    // 1. LÓGICA DEL MENÚ MÓVIL
    const menu = document.getElementById("mobile-menu");
    const openBtn = document.getElementById("hamburger-btn");
    const closeBtn = document.getElementById("close-btn");
    const body = document.body;

    const isMobile = () => window.innerWidth < 1024;

    function openMenu() {
      if (isMobile() && menu) {
        menu.classList.replace("translate-x-full", "translate-x-0");
        body.classList.add("overflow-hidden");
      }
    }

    function closeMenu() {
      if (isMobile() && menu) {
        menu.classList.replace("translate-x-0", "translate-x-full");
        body.classList.remove("overflow-hidden");
      }
    }

    if (openBtn) openBtn.addEventListener("click", openMenu);
    if (closeBtn) closeBtn.addEventListener("click", closeMenu);

    // 2. ACCORDION FUNCTIONALITY FOR SOLUTIONS (Mobile only)
    function initMobileSolutionsAccordion() {
      // Solo para móvil: el toggle del menú móvil
      const mobileSolutionToggle = document.querySelector(
        '[data-solution-toggle="true"]',
      );
      if (!mobileSolutionToggle) return;

      const chevron = mobileSolutionToggle.querySelector(
        '[data-chevron="true"]',
      );
      const menuId = mobileSolutionToggle.getAttribute("aria-controls");
      const submenu = document.getElementById(menuId || "");

      if (!submenu) return;

      mobileSolutionToggle.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();

        const isOpen = submenu.classList.contains("hidden");

        if (isOpen) {
          // Open
          submenu.classList.remove("hidden");
          submenu.classList.add("flex");
          mobileSolutionToggle.setAttribute("aria-expanded", "true");
          if (chevron) chevron.style.transform = "rotate(180deg)";
        } else {
          // Close
          submenu.classList.remove("flex");
          submenu.classList.add("hidden");
          mobileSolutionToggle.setAttribute("aria-expanded", "false");
          if (chevron) chevron.style.transform = "rotate(0deg)";
        }
      });

      // Close accordion when clicking outside (mobile only)
      document.addEventListener("click", (e) => {
        const target = e.target;
        if (
          !target.closest('[data-solution-toggle="true"]') &&
          !target.closest('[data-solution-menu="true"]')
        ) {
          submenu.classList.remove("flex");
          submenu.classList.add("hidden");
          mobileSolutionToggle.setAttribute("aria-expanded", "false");
          if (chevron) chevron.style.transform = "rotate(0deg)";
        }
      });

      // Close accordion on escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          submenu.classList.remove("flex");
          submenu.classList.add("hidden");
          mobileSolutionToggle.setAttribute("aria-expanded", "false");
          if (chevron) chevron.style.transform = "rotate(0deg)";
        }
      });
    }

    initMobileSolutionsAccordion();

    // 3. LÓGICA DEL HEADER (Fondo y GSAP ScrollTrigger)
    const header = document.getElementById("site-header");

    // 4. ACTUALIZAR VARIABLE CSS DE ALTURA (independiente de .header-container-1)
    function updateHeaderHeight() {
      const height = header?.offsetHeight || 0;
      document.documentElement.style.setProperty(
        "--header-height",
        `${height}px`,
      );
    }
    if (header) {
      updateHeaderHeight();
      window.addEventListener("resize", updateHeaderHeight);
    }

    const firstContainerHedaer =
      document.querySelector(".header-container-1") | null;
    if (!header || !firstContainerHedaer) return;

    // Actualizar fondo independientemente de la página (unificado)
    const updateHeaderStyle = () => {
      const scrollY = window.scrollY || document.documentElement.scrollTop;
      const firstSection =
        document.querySelector(".hero-main-section") ||
        document.querySelector("main > section");
      const threshold = firstSection
        ? firstSection.offsetHeight
        : window.innerHeight;

      if (scrollY >= threshold) {
        header.style.backgroundColor = "var(--color-primary-rgb)";
        firstContainerHedaer.style.display = "none";
      } else {
        header.style.backgroundColor = "transparent";
        if (window.innerWidth >= 768) {
          firstContainerHedaer.style.display = "flex";
        }
      }
    };

    window.addEventListener("scroll", updateHeaderStyle, { passive: true });
    updateHeaderStyle(); // Aplicar al cargar
  });
</script>

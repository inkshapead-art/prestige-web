---
import type { Language } from "../../../types/language.type";
import { statisticsCardsConfig } from "../../../data/statisticsCardsConfig";
import CreditBadge from "./CreditBadge.astro";
import CreditBars from "./CreditBars.astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const config = statisticsCardsConfig["flow-optimization"];

// --- flow-1.svg: line chart de dos series con puntos ---
const LINE_DURATION_MS = 1000;
const SERIES_STAGGER_MS = 200; // el trazo dorado arranca un poco después del verde

type Point = { x: number; y: number };

// Calcula, para cada punto, qué % de la longitud total del trazo hay que
// recorrer para llegar a él. Esto sincroniza el "pop" del punto con el
// instante exacto en que el trazo (dibujado por stroke-dashoffset) lo
// alcanza, incluso con puntos espaciados de forma irregular.
function withCumulativeDelay(points: Point[], seriesDelay: number) {
  const distances: number[] = [0];
  for (let i = 1; i < points.length; i++) {
    const dx = points[i].x - points[i - 1].x;
    const dy = points[i].y - points[i - 1].y;
    distances.push(distances[i - 1] + Math.sqrt(dx * dx + dy * dy));
  }
  const total = distances[distances.length - 1];
  return points.map((p, i) => ({
    ...p,
    delay: seriesDelay + (distances[i] / total) * LINE_DURATION_MS,
  }));
}

const greenPoints = withCumulativeDelay(
  [
    { x: 7, y: 66 },
    { x: 69, y: 50 },
    { x: 129, y: 37 },
    { x: 203, y: 32 },
    { x: 259, y: 20 },
    { x: 315, y: 7 },
  ],
  0,
);

const goldPoints = withCumulativeDelay(
  [
    { x: 9, y: 94 },
    { x: 69, y: 82 },
    { x: 129, y: 74 },
    { x: 205, y: 70 },
    { x: 261, y: 70 },
    { x: 315, y: 57 },
  ],
  SERIES_STAGGER_MS,
);
---

<!-- 
  Flow Optimization Statistics Card
  Modify this file to customize the content, structure, and design for the Flow Optimization page.
-->
<div class="flex justify-center items-center gap-6 md:gap-12">
  <div class="flex flex-col justify-center itmes-start">
    <h3
      class="text-[13px] md:text-[22px] leading-[100%] font-semibold text-paragraph"
    >
      {config?.title?.[lang]}
    </h3>
    <div class="w-full flex justify-between items-center mt-4 md:mt-9">
      <p class="text-[13px] text-paragraph font-normal leading-[100%]">
        {config?.subtitle?.[lang]}
      </p>
      <div
        class="flex bg-accent/10 rounded-full justify-center items-center w-16 xl:w-20 h-7 border border-accent"
      >
        <p class="text-accent text-[13px] font-normal leading-[100%]">+18%</p>
      </div>
    </div>
    <p
      class="text-[24px] xl:text-[32px] font-semibold leading-[100%] text-paragraph"
    >
      $145,0000
    </p>

    <!-- flow-1.svg inlineado: line chart de dos series -->
    <svg
      class="flow-chart w-full h-auto mt-[11px]"
      data-animate
      width="322"
      height="118"
      viewBox="0 0 322 118"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <rect
        class="flow-grid-line"
        x="6.91016"
        y="80"
        width="308"
        height="1"
        fill="white"></rect>
      <rect
        class="flow-grid-line"
        x="6.91016"
        y="117"
        width="308"
        height="1"
        fill="white"></rect>
      <rect
        class="flow-grid-line"
        x="6.91016"
        y="43"
        width="308"
        height="1"
        fill="white"></rect>
      <rect
        class="flow-grid-line"
        x="6.91016"
        y="6"
        width="308"
        height="1"
        fill="white"></rect>

      <path
        class="flow-line"
        d="M7 66L69.3797 50.5L127.304 38.5L202.494 31.5L259.304 20L315 7"
        stroke="#006836"
        stroke-width="4"
        pathLength="100"
        style="transition-delay: 0ms;"></path>
      <path
        class="flow-line"
        d="M5 94L66.4 81.5L132.265 75L202.596 70H260.647L312 57"
        stroke="#D3AE6A"
        stroke-width="4"
        pathLength="100"
        style={`transition-delay: ${SERIES_STAGGER_MS}ms;`}></path>

      {
        greenPoints.map((p) => (
          <circle
            class="flow-point"
            cx={p.x}
            cy={p.y}
            r="5.5"
            fill="white"
            stroke="#006836"
            stroke-width="3"
            style={`transition-delay: ${p.delay}ms;`}
          />
        ))
      }
      {
        goldPoints.map((p) => (
          <circle
            class="flow-point"
            cx={p.x}
            cy={p.y}
            r="5.5"
            fill="white"
            stroke="#D3AE6A"
            stroke-width="3"
            style={`transition-delay: ${p.delay}ms;`}
          />
        ))
      }
    </svg>

    <CreditBadge class="w-full h-auto mt-6" />
  </div>
  <CreditBars class="w-full h-auto max-w-[150px] xl:max-w-[224px]" />
</div>

<style>
  /* El grid de fondo aparece rápido, antes de que empiecen a dibujarse las líneas */
  .flow-grid-line {
    opacity: 0;
    transition: opacity 0.3s ease-out;
  }

  .flow-chart.active .flow-grid-line {
    opacity: 1;
  }

  /* Cada línea se dibuja de izquierda a derecha */
  .flow-line {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .flow-chart.active .flow-line {
    stroke-dashoffset: 0;
  }

  /* Cada punto aparece justo cuando la línea lo alcanza */
  .flow-point {
    opacity: 0;
    transform: scale(0.3);
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 0.25s ease-out,
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .flow-chart.active .flow-point {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-grid-line,
    .flow-line,
    .flow-point {
      transition: none !important;
    }
  }
</style>

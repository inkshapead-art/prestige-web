---
import type { Language } from "../../../types/language.type";
import { statisticsCardsConfig } from "../../../data/statisticsCardsConfig";
import CreditGauge from "./CreditGauge.astro";
import CreditBadge from "./CreditBadge.astro";
import CreditBars from "./CreditBars.astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const config = statisticsCardsConfig["credit-optimization"];

const CREDIT_SCORE_VALUE = 720;
const CREDIT_SCORE_MIN = 300;
const CREDIT_SCORE_MAX = 850;
---

<!-- 
  Credit Optimization Statistics Card
  Modify this file to customize the content, structure, and design for the Credit Optimization page.
-->
<div class="w-full flex justify-center items-center gap-6 md:gap-14">
  <div
    class="flex flex-col justify-center items-center gap-4 md:gap-8 max-w-[169px] md:max-w-none"
  >
    <h3
      class="text-[13px] md:text-[22px] leading-[100%] font-semibold text-paragraph"
    >
      {config?.title?.[lang]}
    </h3>

    <CreditGauge
      value={CREDIT_SCORE_VALUE}
      min={CREDIT_SCORE_MIN}
      max={CREDIT_SCORE_MAX}
      label={config?.subtitle?.[lang]}
      svgClass="w-full h-auto "
    />

    <CreditBadge class="w-full h-auto " />
  </div>

  <CreditBars class="w-full h-auto max-w-[150px] xl:max-w-[224px]" />
</div>

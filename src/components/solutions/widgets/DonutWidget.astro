---
import type { Language } from "../../../types/language.type";
import type { DonutData } from "../../../types/solutionCards.type";
import CountUp from "./CountUp.astro";

interface Props {
  title: string;
  data: DonutData;
  lang: Language;
}

const { title, data, lang } = Astro.props;
const { layout, centerValue, centerSubLabel, segments } = data;

const TOTAL_DURATION = 1200; // ms para el círculo completo (100%)

let cumulative = 0;
const arcs = segments.map((seg) => {
  const arc = {
    ...seg,
    offset: 100 - cumulative,
    delay: Math.round((cumulative / 100) * TOTAL_DURATION),
    duration: Math.max(Math.round((seg.percent / 100) * TOTAL_DURATION), 250),
  };
  cumulative += seg.percent;
  return arc;
});
---

<div>
  <h3
    class="text-[7px] md:text-[10px] font-medium leading-[100%] text-paragraph mb-4 text-center"
  >
    {title}
  </h3>

  <div
    class:list={[
      "flex",
      layout === "side"
        ? "items-center gap-2 md:gap-4"
        : "flex-col items-center gap-2",
    ]}
  >
    <div
      class="relative shrink-0 w-[50px] xl:w-20 h-[50px] xl:h-20 donut-chart"
      data-animate
    >
      <svg viewBox="0 0 80 80" class="w-full h-full -rotate-90">
        <circle
          cx="40"
          cy="40"
          r="32"
          fill="none"
          stroke="#F1F1EF"
          stroke-width="12"></circle>
        {
          arcs.map((arc) => (
            <circle
              cx="40"
              cy="40"
              r="32"
              fill="none"
              stroke={arc.color}
              stroke-width="12"
              pathLength="100"
              class="donut-segment"
              stroke-dasharray={`${arc.percent} ${100 - arc.percent}`}
              stroke-dashoffset={arc.offset}
              style={`--dash-target: ${arc.percent} ${100 - arc.percent}; transition-delay: ${arc.delay}ms; transition-duration: ${arc.duration}ms;`}
            />
          ))
        }
      </svg>
      <div
        class="absolute inset-0 flex items-center justify-center donut-center"
      >
        <span
          class="text-[5px] lg:text-[8px] xl:text-[10px] font-semibold leading-[100%] text-paragraph"
          ><CountUp value={centerValue} delay={900} duration={1000} /></span
        >
      </div>
    </div>

    {
      layout === "stacked" && centerSubLabel && (
        <span class="text-[7.2px] md:text-[10px] font-medium text-paragraph">
          {centerSubLabel[lang]}
        </span>
      )
    }

    <ul
      class:list={[
        "flex flex-col gap-[6px] md:gap-2.25 text-[5px] md:text-[9px]",
        layout === "stacked" && "w-full mt-1",
      ]}
    >
      {
        segments.map((seg, i) => (
          <li class="flex items-center justify-between gap-2.5">
            <span class="flex items-center gap-2 text-paragraph">
              <span
                class="w-[5px] md:w-2 h-[5px] md:h-2 rounded-full inline-block shrink-0"
                style={`background:${seg.color}`}
              />
              {seg.label[lang]}
            </span>
            <span class="text-paragraph shrink-0">
              <CountUp
                value={seg.displayValue ?? `${seg.percent}%`}
                delay={200 + i * 120}
                duration={800}
              />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .donut-segment {
    stroke-dasharray: 0 100; /* estado inicial: invisible, pisa el atributo del SVG */
    transition-property: stroke-dasharray;
    transition-timing-function: ease-out;
  }

  .donut-chart.active .donut-segment {
    stroke-dasharray: var(--dash-target);
  }

  .donut-center span {
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.4s ease-out,
      transform 0.4s ease-out;
    transition-delay: 900ms; /* aparece cuando el trazo ya casi terminó */
  }

  .donut-chart.active .donut-center span {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .donut-segment,
    .donut-center span {
      transition: none !important;
    }
  }
</style>

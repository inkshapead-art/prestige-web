---
import type { Language } from "../../../types/language.type";
import type { DonutData } from "../../../types/solutionCards.type";

interface Props {
  title: string;
  data: DonutData;
  lang: Language;
}

const { title, data, lang } = Astro.props;
const { layout, centerValue, centerSubLabel, segments } = data;

// pathLength="100" makes stroke-dasharray/offset work directly in
// percentage units, so no manual circumference math is needed.
let cumulative = 0;
const arcs = segments.map((seg) => {
  const arc = { ...seg, offset: 100 - cumulative };
  cumulative += seg.percent;
  return arc;
});
---

<div>
  <h3
    class="text-[7px] md:text-[10px] font-medium leading-[100%] text-paragraph mb-4 text-center"
  >
    {title}
  </h3>

  <div
    class:list={[
      "flex",
      layout === "side" ? "items-center gap-2 md:gap-4" : "flex-col items-center gap-2",
    ]}
  >
    <div class="relative shrink-0 w-[50px] xl:w-20 h-[50px] xl:h-20">
      <svg viewBox="0 0 80 80" class="w-full h-full -rotate-90">
        <circle
          cx="40"
          cy="40"
          r="32"
          fill="none"
          stroke="#F1F1EF"
          stroke-width="12"></circle>
        {
          arcs.map((arc) => (
            <circle
              cx="40"
              cy="40"
              r="32"
              fill="none"
              stroke={arc.color}
              stroke-width="12"
              pathLength="100"
              stroke-dasharray={`${arc.percent} ${100 - arc.percent}`}
              stroke-dashoffset={arc.offset}
            />
          ))
        }
      </svg>
      <div class="absolute inset-0 flex items-center justify-center">
        <span
          class="text-[5px] lg:text-[8px] xl:text-[10px] font-semibold leading-[100%] text-paragraph"
          >{centerValue}</span
        >
      </div>
    </div>

    {
      layout === "stacked" && centerSubLabel && (
        <span class="text-[7.2px] md:text-[10px] font-medium text-paragraph">
          {centerSubLabel[lang]}
        </span>
      )
    }

    <ul
      class:list={[
        "flex flex-col gap-[6px] md:gap-2.25 text-[5px] md:text-[9px]",
        layout === "stacked" && "w-full mt-1",
      ]}
    >
      {
        segments.map((seg) => (
          <li class="flex items-center justify-between gap-2.5">
            <span class="flex items-center gap-2 text-paragraph">
              <span
                class="w-[5px] md:w-2 h-[5px] md:h-2 rounded-full inline-block shrink-0"
                style={`background:${seg.color}`}
              />
              {seg.label[lang]}
            </span>
            <span class="text-paragraph shrink-0">
              {seg.displayValue ?? `${seg.percent}%`}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

---
import type { Language } from "../../../types/language.type";
import type { BadgeProgressData } from "../../../types/solutionCards.type";
import ArrowUpIcon from "../icons/ArrowUpIcon.astro";
import CountUp from "./CountUp.astro";

interface Props {
  title: string;
  data: BadgeProgressData;
  lang: Language;
}

const { title, data, lang } = Astro.props;
const { bigValue, progressPercent, statusText } = data;
---

<div class="text-paragraph badge-progress" data-animate>
  <h3 class="text-[10px] font-medium leading-[100%] text-paragraph">
    {title}
  </h3>
  <div
    class="text-[20.3px] xl:text-[36px] font-medium leading-[120%] mb-[6.2px] md:mb-2.75"
  >
    <CountUp value={bigValue} delay={150} duration={1100} />
  </div>
  <div
    class="h-2 md:h-3.5 w-[109px] lg:w-[193px] rounded-full bg-[#E3E2E2] overflow-hidden mb-[6.2px] md:mb-2.75"
  >
    <div
      class="progress-bar h-full rounded-full bg-[#051913]"
      style={`--progress-target: ${progressPercent}%`}
    >
    </div>
  </div>
  <div class="flex items-center justify-between">
    <span
      class="text-[6px] lg:text-[10px] font-medium leading-[100%] text-accent"
      >{statusText[lang]}</span
    >
    <svg
      class="progress-badge"
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <circle cx="7.75" cy="7.75" r="7.75" fill="#006836"></circle>
      <path
        d="M7.52872 11.0714V3.98572M4.87158 6.64286L7.52872 3.98572L10.1859 6.64286"
        stroke="white"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>
</div>

<style>
  .progress-bar {
    width: 0%;
    transition: width 1s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0.15s;
  }

  .badge-progress.active .progress-bar {
    width: var(--progress-target);
  }

  .progress-badge {
    opacity: 0;
    transform: scale(0.5);
    transition:
      opacity 0.35s ease-out,
      transform 0.35s ease-out;
    transition-delay: 1.1s; /* aparece cuando la barra ya casi terminó */
  }

  .badge-progress.active .progress-badge {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .progress-bar,
    .progress-badge {
      transition: none !important;
    }
  }
</style>
